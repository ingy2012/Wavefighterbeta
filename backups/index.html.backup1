<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>TRIFORM: Wave Arena - Multiplayer</title>
<style>
  html,body{margin:0;padding:0;overflow:hidden;background:#000;font-family:'Segoe UI',Arial,sans-serif;user-select:none;-webkit-user-select:none;}
  #c{display:block;width:100vw;height:100vh;}
  #hud{position:fixed;inset:0;pointer-events:none;color:#eee;text-shadow:0 1px 3px rgba(0,0,0,.9);z-index:2;}
  
  /* HUD Elements */
  .bar-wrap{position:absolute;left:20px;bottom:20px;width:220px;}
  .bar{height:14px;border-radius:7px;background:rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.25);overflow:hidden;margin-bottom:4px;}
  .bar-fill{height:100%;transition:width .15s;}
  #hpFill{background:linear-gradient(90deg,#ff3b3b,#ff7a3b);}
  #resFill{background:linear-gradient(90deg,#3ba7ff,#3bffd8);}
  #resFill.stam{background:linear-gradient(90deg,#8cff3b,#e8ff3b);}
  .label{font-size:10px;letter-spacing:1px;opacity:.85;margin-bottom:2px;}
  
  #topCenter{position:absolute;top:12px;left:50%;transform:translateX(-50%);text-align:center;}
  #waveText{font-size:20px;font-weight:700;letter-spacing:2px;}
  #enemyCount{font-size:12px;opacity:.85;margin-top:1px;}
  
  #styleBox{position:absolute;right:170px;top:16px;text-align:right;max-width:240px;pointer-events:none;}
  #styleName{font-size:18px;font-weight:800;letter-spacing:1px;}
  #weaponName{font-size:13px;opacity:.9;margin-top:1px;}
  #subLine{font-size:11px;opacity:.75;margin-top:1px;}
  
  #crosshair{position:absolute;top:50%;left:50%;width:20px;height:20px;transform:translate(-50%,-50%);}
  #crosshair:before,#crosshair:after{content:'';position:absolute;background:#fff;box-shadow:0 0 2px #000;}
  #crosshair:before{left:9px;top:2px;width:2px;height:16px;}
  #crosshair:after{top:9px;left:2px;height:2px;width:16px;}
  #chargeRing{position:absolute;top:50%;left:50%;width:44px;height:44px;transform:translate(-50%,-50%);border-radius:50%;border:3px solid rgba(255,220,120,.9);clip-path:inset(0 0 0 0);display:none;}
  #flash{position:fixed;inset:0;background:rgba(255,0,0,0);transition:background .1s;pointer-events:none;z-index:3;}
  #msgCenter{position:absolute;top:35%;left:50%;transform:translate(-50%,-50%);text-align:center;font-size:28px;font-weight:800;letter-spacing:3px;opacity:0;transition:opacity .4s;}
  
  .overlay{position:fixed;inset:0;background:rgba(5,8,15,.92);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#eee;text-align:center;pointer-events:all;z-index:20;}
  .overlay h1{font-size:36px;letter-spacing:4px;margin:0 0 6px;background:linear-gradient(90deg,#ff8a3b,#3bd0ff,#b93bff);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .overlay h2{font-weight:400;opacity:.7;margin-top:0;font-size:14px;}
  
  .controls-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin:16px 0;max-width:860px;}
  .cgroup{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:10px 12px;text-align:left;}
  .cgroup h3{margin:0 0 6px;font-size:12px;letter-spacing:1px;}
  .cgroup div{font-size:11px;opacity:.85;margin:2px 0;}
  
  button.big{background:linear-gradient(135deg,#ff8a3b,#ff3b6b);border:none;color:#fff;font-size:16px;font-weight:700;letter-spacing:2px;padding:12px 36px;border-radius:24px;cursor:pointer;box-shadow:0 4px 20px rgba(255,80,80,.4);}
  button.big:active{transform:scale(.96);}
  
  /* Multiplayer Hub Specific Styles */
  button.blue-btn { background:linear-gradient(135deg,#3b8aff,#3bd0ff); box-shadow:0 4px 20px rgba(59,138,255,.4); margin: 0 10px; }
  button.green-btn { background:linear-gradient(135deg,#3bff8a,#3bffd8); box-shadow:0 4px 20px rgba(59,255,138,.4); margin: 0 10px; color:#000; }
  
  .lobby-panel { background: rgba(20,25,35,0.95); padding: 2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); width: 90%; max-width: 500px; text-align: left;}
  .lobby-input { width: 100%; padding: 12px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 6px; margin-bottom: 16px; font-size: 16px; }
  .player-list-item { display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.05); padding: 12px; border-radius: 6px; margin-bottom: 8px;}
  
  #notification-toast {
      position: absolute; top: 20px; right: -400px; background: rgba(49, 130, 206, 0.95); padding: 15px 25px;
      border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); z-index: 50;
      transition: right 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      display: flex; align-items: center; gap: 15px; border-left: 4px solid #90cdf4; color: white; pointer-events:none;
  }
  #notification-toast.show { right: 20px; }
  
  #statLine{margin-top:12px;font-size:13px;opacity:.8;}
  .hidden{display:none !important;}
  #stateTag{font-size:11px;font-weight:700;letter-spacing:1px;margin-top:4px;padding:2px 8px;border-radius:6px;display:inline-block;}
  #stateTag.zoom{background:rgba(59,167,255,.35);color:#bfe6ff;}
  #stateTag.block{background:rgba(140,255,59,.3);color:#ddffbf;}
  #debugPanel{position:absolute;left:20px;top:16px;font-size:11px;opacity:.8;background:rgba(0,0,0,.4);padding:6px 10px;border-radius:6px;display:none;max-width:280px;line-height:1.5;}
  
  #radar{position:absolute;top:12px;right:16px;background:rgba(10,18,28,.6);border:2px solid rgba(255,255,255,.25);border-radius:50%;z-index:2;}
  #loadError{position:fixed;inset:0;background:#0b0d14;color:#ff8a8a;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px;z-index:999;font-size:15px;line-height:1.5;}
  #loadError h2{color:#ff6a6a;font-size:22px;margin-bottom:10px;}
  #loadError button{margin-top:18px;background:#ff8a3b;border:none;color:#000;font-weight:700;padding:10px 26px;border-radius:20px;font-size:15px;cursor:pointer;}
  #loadingMsg{position:fixed;inset:0;background:#0b0d14;color:#ccc;display:flex;align-items:center;justify-content:center;font-size:18px;letter-spacing:2px;z-index:998;}
  
  #settingsBody{display:flex;gap:20px;max-width:700px;width:100%;max-height:48vh;overflow-y:auto;text-align:left;margin-top:6px;}
  .bindCol{flex:1;min-width:0;}
  .bindCol h3{opacity:.7;font-size:12px;letter-spacing:1px;margin:0 0 6px;}
  .bindRow{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:5px 4px;border-bottom:1px solid rgba(255,255,255,.08);font-size:12px;}
  .bindBtn{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);color:#fff;padding:4px 8px;border-radius:6px;font-size:11px;cursor:pointer;min-width:60px;white-space:nowrap;}
  .bindBtn.listening{background:rgba(255,180,60,.45);border-color:#ffb43c;color:#fff;}
  .modeBtn.active,.touchModeBtn.active{background:rgba(102,217,255,.35);border-color:#66d9ff;color:#fff;}
  
  /* Touch Controls Styles & Dynamic Layouts */
  #touchControls{position:fixed;inset:0;z-index:10;display:none;pointer-events:none;}
  #touchControls.enabled{display:block;}
  #touchLookZone{position:absolute;inset:0;pointer-events:auto;touch-action:none;}
  
  #touchJoystickBase{position:absolute;width:110px;height:110px;border-radius:50%;background:rgba(255,255,255,.08);border:2px solid rgba(255,255,255,.25);pointer-events:auto;touch-action:none;}
  #touchJoystickKnob{position:absolute;left:32px;top:32px;width:46px;height:46px;border-radius:50%;background:rgba(255,255,255,.35);pointer-events:none;}
  
  .touchBtn{pointer-events:auto;touch-action:none;border-radius:50%;background:rgba(255,255,255,.14);border:1.5px solid rgba(255,255,255,.35);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;user-select:none;-webkit-user-select:none;box-shadow:0 2px 8px rgba(0,0,0,.3);}
  .touchBtn:active{background:rgba(255,255,255,.35);}
  #tPause{position:absolute;left:16px;top:16px;width:38px;height:38px;font-size:10px;}

  #touchMainButtons{position:absolute;display:flex;gap:10px;align-items:flex-end;pointer-events:auto;}
  .mainBtnCol{display:flex;flex-direction:column;gap:8px;align-items:center;}
  #tFire{width:72px;height:72px;font-size:13px;background:rgba(255,100,60,.35);border-color:rgba(255,140,100,.6);}
  #tAlt{width:54px;height:54px;font-size:10px;background:rgba(60,140,255,.35);border-color:rgba(100,170,255,.6);}
  #tJump,#tSprint{width:44px;height:44px;font-size:9.5px;}

  #touchActionGrid{position:absolute;display:flex;gap:6px;pointer-events:auto;}
  #touchActionGrid .touchBtn{width:42px;height:36px;font-size:9.5px;border-radius:8px;background:rgba(255,255,255,.12);}

  @media (orientation: landscape) {
    #radar{width:110px;height:110px;}
    .bar-wrap{left:16px;bottom:16px;width:200px;}
    #styleBox{right:140px;top:16px;text-align:right;}
    #topCenter{left:50%;transform:translateX(-50%);text-align:center;top:12px;}
    #touchJoystickBase{left:20px;bottom:95px;width:110px;height:110px;}
    #touchJoystickKnob{left:32px;top:32px;width:46px;height:46px;}
    #touchMainButtons{right:85px;bottom:20px;}
    #touchActionGrid{ left:50%; bottom:16px; transform:translateX(-50%); flex-direction:row; justify-content:center; }
  }

  @media (orientation: portrait) {
    #radar{width:90px;height:90px;top:10px;right:10px;}
    .bar-wrap{left:16px;bottom:16px;width:180px;}
    #styleBox{right:110px;top:12px;text-align:right;}
    #topCenter{ left:64px; top:12px; transform:none; text-align:left; }
    #touchJoystickBase{left:16px;bottom:100px;width:105px;height:105px;}
    #touchJoystickKnob{left:30px;top:30px;width:44px;height:44px;}
    #touchMainButtons{right:24px;bottom:24px;}
    #touchActionGrid{ right:16px; bottom:230px; display:grid; grid-template-columns:repeat(4,42px); gap:6px; justify-end; }
  }
</style>
</head>
<body>
<div id="loadingMsg">LOADING ENGINE&hellip;</div>
<canvas id="c"></canvas>
<div id="flash"></div>
<div id="hud">
  <div class="bar-wrap">
    <div class="label">HEALTH</div>
    <div class="bar"><div class="bar-fill" id="hpFill" style="width:100%"></div></div>
    <div class="label" id="resLabel">MANA</div>
    <div class="bar"><div class="bar-fill" id="resFill" style="width:100%"></div></div>
  </div>
  <div id="topCenter">
    <div id="waveText">WAVE 1</div>
    <div id="enemyCount">enemies: 0</div>
    <div id="scoreText" style="font-size:11px;opacity:.8;margin-top:2px;">Score: 0</div>
  </div>
  <div id="styleBox">
    <div id="styleName">FPS</div>
    <div id="weaponName">Assault Rifle</div>
    <div id="subLine"></div>
    <div id="ammoLine" style="font-size:11px;opacity:.85;margin-top:2px;display:none;"></div>
    <div id="stateTag" style="display:none;"></div>
  </div>
  <div id="debugPanel"></div>
  <canvas id="radar" width="150" height="150"></canvas>
  <div id="crosshair"></div>
  <div id="chargeRing"></div>
  <div id="msgCenter"></div>
</div>

<div id="touchControls">
  <div id="touchLookZone"></div>
  <div id="touchJoystickBase"><div id="touchJoystickKnob"></div></div>
  <button class="touchBtn" id="tPause">II</button>
  <div id="touchActionGrid">
    <button class="touchBtn" id="tStylePrev">Sty‹</button>
    <button class="touchBtn" id="tStyleNext">Sty›</button>
    <button class="touchBtn" id="tSlotPrev">Wpn‹</button>
    <button class="touchBtn" id="tSlotNext">Wpn›</button>
    <button class="touchBtn" id="tSubPrev">Sub‹</button>
    <button class="touchBtn" id="tSubNext">Sub›</button>
    <button class="touchBtn" id="tReload">RLD</button>
    <button class="touchBtn" id="tShout">SHT</button>
  </div>
  <div id="touchMainButtons">
    <div class="mainBtnCol">
      <button class="touchBtn" id="tSprint">SPR</button>
      <button class="touchBtn" id="tJump">JMP</button>
    </div>
    <div class="mainBtnCol">
      <button class="touchBtn" id="tAlt">ALT</button>
      <button class="touchBtn" id="tFire">FIRE</button>
    </div>
  </div>
</div>

<!-- Main Start Screen -->
<div class="overlay" id="startOverlay">
  <h1>TRIFORM: WAVE ARENA</h1>
  <h2>fight endless waves in the maze &mdash; switch combat styles on the fly</h2>
  <div class="controls-grid">
    <div class="cgroup">
      <h3>MOVE / LOOK</h3>
      <div>Gamepad: Left stick move, Right stick look</div>
      <div>Keyboard: WASD move, Mouse look (click to lock)</div>
      <div>Jump: A button / Space</div>
      <div>Sprint: hold Shift, or click L3 to toggle</div>
    </div>
    <div class="cgroup">
      <h3>STYLE &amp; SLOTS</h3>
      <div>Switch style: LB / RB or Q / E</div>
      <div>D-pad Up/Down (R/F): cycle weapon or RT spell</div>
      <div>D-pad Left/Right (arrows): cycle arrow element or LT spell</div>
      <div>FPS: Rifle / Sniper / Shotgun / Dual Pistols</div>
    </div>
    <div class="cgroup">
      <h3>ACTIONS</h3>
      <div>Primary: RT / Left Click (swing, shoot, charge fire/ice/lightning/bow)</div>
      <div>Secondary: LT / Right Click</div>
      <div>Unleash shout (Magic only): Y / T key</div>
      <div>Radar top-right shows enemies and walls</div>
    </div>
  </div>
  <div style="display:flex; gap: 15px; margin-top: 15px;">
      <button class="big" id="startBtn">PLAY SOLO</button>
      <button class="big blue-btn" id="onlineLobbyBtn">ONLINE LOBBY</button>
      <button class="big green-btn" id="localSplitBtn">LOCAL CO-OP</button>
  </div>
  <div><button class="big" id="startSettingsBtn" style="margin-top:10px;background:linear-gradient(135deg,#555,#333);font-size:13px;padding:8px 24px;">SETTINGS</button></div>
  <div id="statLine">Best wave reached: <span id="bestWave">0</span> &nbsp;|&nbsp; Best score: <span id="bestScore">0</span></div>
</div>

<!-- Multiplayer Name Entry & Lobby -->
<div class="overlay hidden" id="lobbyOverlay">
  <div class="lobby-panel" id="nameEntryPanel">
      <h2 style="font-size: 24px; color:#3bd0ff; margin-bottom: 15px; margin-top:0;">Connect to Servers</h2>
      <input type="text" id="playerNameInput" class="lobby-input" placeholder="Enter your pilot name..." maxlength="15">
      <button id="btnLogin" class="big blue-btn" style="width: 100%; margin:0;">CONNECT</button>
      <button id="btnLobbyBack" class="big" style="width: 100%; margin: 10px 0 0 0; background: #555;">BACK</button>
  </div>

  <div class="lobby-panel hidden" id="activeLobbyPanel">
      <h2 style="font-size: 24px; color:#3bd0ff; margin-bottom: 15px; margin-top:0;">Online Pilots</h2>
      <div id="playerList" style="max-height: 250px; overflow-y: auto; margin-bottom: 15px;">
          <!-- Players injected here via Firebase -->
          <div style="color: #888; text-align:center;">Scanning for signals...</div>
      </div>
      <button id="btnLeaveLobby" class="big" style="width: 100%; margin:0; background: #555;">LEAVE LOBBY</button>
  </div>
</div>

<!-- Non-intrusive In-Game Notification -->
<div id="notification-toast">
    <div>
        <div style="font-weight: bold; font-size: 16px;" id="toast-title">New Challenger!</div>
        <div style="font-size: 13px; color: #bee3f8;" id="toast-desc">PilotX wants to join. Press ESC/Pause to manage.</div>
    </div>
</div>

<div class="overlay hidden" id="deathOverlay">
  <h1 style="background:linear-gradient(90deg,#ff3b3b,#8a1a1a);-webkit-background-clip:text;background-clip:text;">YOU FELL</h1>
  <h2 id="deathWaveText">You reached wave 1</h2>
  <button class="big" id="retryBtn">TRY AGAIN</button>
</div>

<div class="overlay hidden" id="pauseOverlay">
  <h1 style="font-size:32px;">PAUSED</h1>
  
  <div id="pending-requests-container" class="hidden" style="background: rgba(0,0,0,0.5); padding: 15px; border-radius: 8px; margin-bottom: 20px; width: 100%; max-width: 400px; text-align:left;">
      <h3 style="color: #ffb43c; margin: 0 0 10px 0; font-size: 14px;">Incoming Join Requests</h3>
      <div id="requests-list" style="display:flex; flex-direction:column; gap:8px;">
          <!-- Requests injected here -->
      </div>
  </div>

  <button class="big" id="resumeBtn">RESUME</button>
  <button class="big" id="pauseSettingsBtn" style="margin-top:12px;background:linear-gradient(135deg,#3b8aff,#3bd0ff);">SETTINGS</button>
</div>

<div class="overlay hidden" id="settingsOverlay">
  <h1 style="font-size:28px;">SETTINGS</h1>
  <div style="max-width:600px;width:100%;text-align:left;margin-top:4px;">
    <h3 style="opacity:.7;font-size:12px;letter-spacing:1px;">SHOOTING MODE</h3>
    <div id="modeButtons" style="display:flex;gap:8px;flex-wrap:wrap;">
      <button class="bindBtn modeBtn" data-mode="unlimited">Unlimited</button>
      <button class="bindBtn modeBtn" data-mode="ammo">Ammo + Reload</button>
      <button class="bindBtn modeBtn" data-mode="precision">Precision Score</button>
    </div>
    <div id="modeDesc" style="font-size:11px;opacity:.65;margin-top:4px;"></div>
  </div>
  <div style="max-width:600px;width:100%;text-align:left;margin-top:10px;">
    <h3 style="opacity:.7;font-size:12px;letter-spacing:1px;">TOUCH CONTROLS</h3>
    <div style="display:flex;gap:8px;">
      <button class="bindBtn touchModeBtn" data-touch="off">OFF</button>
      <button class="bindBtn touchModeBtn" data-touch="on">ON</button>
    </div>
    <div style="font-size:11px;opacity:.65;margin-top:4px;">Adds on-screen controls adapted for portrait and landscape touch devices.</div>
    <div style="margin-top:8px;">
      <label style="font-size:11px;opacity:.8;">Look Sensitivity: <span id="sensValueLabel">1.0x</span></label><br>
      <input type="range" id="sensSlider" min="0.4" max="2.5" step="0.1" value="1" style="width:100%;accent-color:#66d9ff;margin-top:4px;">
    </div>
  </div>
  <h2 style="margin-top:12px;">click a binding, then press key or button</h2>
  <div id="settingsBody">
    <div class="bindCol">
      <h3>KEYBOARD</h3>
      <div id="keyBindList"></div>
    </div>
    <div class="bindCol">
      <h3>GAMEPAD</h3>
      <div id="gpBindList"></div>
    </div>
  </div>
  <div style="margin-top:12px;display:flex;gap:10px;flex-wrap:wrap;justify-center;">
    <button class="big" id="resetBindsBtn" style="background:linear-gradient(135deg,#555,#333);font-size:13px;padding:8px 20px;">RESET DEFAULTS</button>
    <button class="big" id="settingsBackBtn" style="font-size:13px;padding:8px 20px;">BACK</button>
  </div>
</div>

<div id="loadError" class="hidden">
  <h2>Couldn't start the game</h2>
  <div id="loadErrorDetail">The 3D engine failed to load.</div>
  <button onclick="location.reload()">RELOAD</button>
</div>

<script>
window.__startGame = function(){
"use strict";

const canvas = document.getElementById('c');
const renderer = new THREE.WebGLRenderer({canvas, antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.shadowMap.enabled = true;
// Enable scissor test for Splitscreen
renderer.setScissorTest(false); 

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x0b1220);
scene.fog = new THREE.Fog(0x0b1220, 22, 85);

// Camera 1 (Player 1)
const camera = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 300);
// Camera 2 (Player 2 Splitscreen)
const camera2 = new THREE.PerspectiveCamera(75, innerWidth/innerHeight, 0.1, 300);
const baseFOV = 75;

// ==========================================
// STATE DECLARED HERE BEFORE RESIZE IS CALLED
// ==========================================
const state = { wave:0, enemiesRemaining:0, betweenWaves:true, score:0, precisionMultiplier:1, isSplitscreen: false };

// Layer magic to hide P1 body from P1 camera, but P2 can see P1
camera.layers.enable(0);
camera.layers.enable(2); // Can see Player 2 layer
camera2.layers.enable(0);
camera2.layers.enable(1); // Can see Player 1 layer

function resize(){
  renderer.setSize(innerWidth, innerHeight);
  if(state.isSplitscreen) {
      camera.aspect = (innerWidth/2)/innerHeight;
      camera2.aspect = (innerWidth/2)/innerHeight;
  } else {
      camera.aspect = innerWidth/innerHeight;
  }
  camera.updateProjectionMatrix();
  camera2.updateProjectionMatrix();
}
addEventListener('resize', resize);
resize();

scene.add(new THREE.AmbientLight(0x8899bb, 0.55));
const sun = new THREE.DirectionalLight(0xffe8c0, 1.1);
sun.position.set(30,50,10);
sun.castShadow = true;
scene.add(sun);
scene.add(new THREE.HemisphereLight(0x4477aa, 0x221100, 0.5));

function makeCheckerTexture(colorA, colorB, size){
  size = size || 64;
  const cnv = document.createElement('canvas');
  cnv.width = cnv.height = size*2;
  const ctx = cnv.getContext('2d');
  ctx.fillStyle = colorA; ctx.fillRect(0,0,size*2,size*2);
  ctx.fillStyle = colorB;
  ctx.fillRect(0,0,size,size);
  ctx.fillRect(size,size,size,size);
  const tex = new THREE.CanvasTexture(cnv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  return tex;
}
const floorTex = makeCheckerTexture('#1f2937','#334155');
floorTex.repeat.set(22,22);
const wallTex = makeCheckerTexture('#0f3d3a','#2a9d8f');
wallTex.repeat.set(3,1);

const ARENA_HALF = 42;
const GRID_N = 8;
const CELL = (ARENA_HALF*2)/GRID_N;
const WALL_H = 3.2, WALL_T = 0.6;
const KEEP_PROB = 0.32;

const groundGeo = new THREE.PlaneGeometry(ARENA_HALF*2, ARENA_HALF*2);
const groundMat = new THREE.MeshStandardMaterial({map:floorTex, roughness:0.95});
const ground = new THREE.Mesh(groundGeo, groundMat);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

const wallMat = new THREE.MeshStandardMaterial({map:wallTex, roughness:0.85});
let wallMeshes = [];
let wallColliders = [];
const outerWallMeshes = [], outerWallColliders = [];
let innerWallMeshes = [], innerWallColliders = [];

function addWallTo(meshArr, colliderArr, cx, cz, w, d){
  const geo = new THREE.BoxGeometry(w, WALL_H, d);
  const m = new THREE.Mesh(geo, wallMat);
  m.position.set(cx, WALL_H/2, cz);
  m.castShadow = true; m.receiveShadow = true;
  scene.add(m);
  meshArr.push(m);
  colliderArr.push({mesh:m, hx:w/2, hz:d/2});
}

addWallTo(outerWallMeshes, outerWallColliders, 0, -ARENA_HALF, ARENA_HALF*2+WALL_T, WALL_T);
addWallTo(outerWallMeshes, outerWallColliders, 0, ARENA_HALF, ARENA_HALF*2+WALL_T, WALL_T);
addWallTo(outerWallMeshes, outerWallColliders, -ARENA_HALF, 0, WALL_T, ARENA_HALF*2+WALL_T);
addWallTo(outerWallMeshes, outerWallColliders, ARENA_HALF, 0, WALL_T, ARENA_HALF*2+WALL_T);

function generateInteriorMaze(){
  for(const m of innerWallMeshes) scene.remove(m);
  innerWallMeshes = []; innerWallColliders = [];

  const vWall = {}, hWall = {};
  const vKey=(i,j)=>i+'_'+j, hKey=(j,i)=>j+'_'+i;
  for(let i=1;i<GRID_N;i++) for(let j=0;j<GRID_N;j++) vWall[vKey(i,j)] = Math.random() < KEEP_PROB;
  for(let j=1;j<GRID_N;j++) for(let i=0;i<GRID_N;i++) hWall[hKey(j,i)] = Math.random() < KEEP_PROB;

  const cc = Math.floor(GRID_N/2);
  vWall[vKey(cc,cc-1)] = false; vWall[vKey(cc,cc)] = false;
  hWall[hKey(cc,cc-1)] = false; hWall[hKey(cc,cc)] = false;

  function neighborsOpen(ci,cj){
    const res = [];
    if(ci>0 && !vWall[vKey(ci,cj)]) res.push([ci-1,cj]);
    if(ci<GRID_N-1 && !vWall[vKey(ci+1,cj)]) res.push([ci+1,cj]);
    if(cj>0 && !hWall[hKey(cj,ci)]) res.push([ci,cj-1]);
    if(cj<GRID_N-1 && !hWall[hKey(cj+1,ci)]) res.push([ci,cj+1]);
    return res;
  }
  function bfsReachable(){
    const seen = new Set();
    seen.add(cc+'_'+cc);
    const q = [[cc,cc]];
    while(q.length){
      const [ci,cj] = q.shift();
      for(const n of neighborsOpen(ci,cj)){
        const k = n[0]+'_'+n[1];
        if(!seen.has(k)){ seen.add(k); q.push(n); }
      }
    }
    return seen;
  }
  for(let iter=0; iter<GRID_N*GRID_N+4; iter++){
    const seen = bfsReachable();
    if(seen.size >= GRID_N*GRID_N) break;
    let opened = false;
    for(let ci=0; ci<GRID_N && !opened; ci++){
      for(let cj=0; cj<GRID_N && !opened; cj++){
        if(seen.has(ci+'_'+cj)) continue;
        if(ci>0 && seen.has((ci-1)+'_'+cj) && vWall[vKey(ci,cj)]){ vWall[vKey(ci,cj)]=false; opened=true; break; }
        if(ci<GRID_N-1 && seen.has((ci+1)+'_'+cj) && vWall[vKey(ci+1,cj)]){ vWall[vKey(ci+1,cj)]=false; opened=true; break; }
        if(cj>0 && seen.has(ci+'_'+(cj-1)) && hWall[hKey(cj,ci)]){ hWall[hKey(cj,ci)]=false; opened=true; break; }
        if(cj<GRID_N-1 && seen.has(ci+'_'+(cj+1)) && hWall[hKey(cj+1,ci)]){ hWall[hKey(cj+1,ci)]=false; opened=true; break; }
      }
    }
    if(!opened) break;
  }

  for(let i=1;i<GRID_N;i++){
    for(let j=0;j<GRID_N;j++){
      if(vWall[vKey(i,j)]){
        const x = -ARENA_HALF + CELL*i;
        const z = -ARENA_HALF + CELL*(j+0.5);
        addWallTo(innerWallMeshes, innerWallColliders, x, z, WALL_T, CELL);
      }
    }
  }
  for(let j=1;j<GRID_N;j++){
    for(let i=0;i<GRID_N;i++){
      if(hWall[hKey(j,i)]){
        const x = -ARENA_HALF + CELL*(i+0.5);
        const z = -ARENA_HALF + CELL*j;
        addWallTo(innerWallMeshes, innerWallColliders, x, z, CELL, WALL_T);
      }
    }
  }
  wallMeshes = outerWallMeshes.concat(innerWallMeshes);
  wallColliders = outerWallColliders.concat(innerWallColliders);
}
generateInteriorMaze();

const radarCanvas = document.getElementById('radar');
const radarCtx = radarCanvas.getContext('2d');
const RADAR_SIZE = 150;
const RADAR_SCALE = (RADAR_SIZE/2 - 8);
const radarBg = document.createElement('canvas');
radarBg.width = RADAR_SIZE; radarBg.height = RADAR_SIZE;
const radarBgCtx = radarBg.getContext('2d');

function worldToRadar(x, z){
  return { rx: RADAR_SIZE/2 + (x/ARENA_HALF)*RADAR_SCALE, ry: RADAR_SIZE/2 + (z/ARENA_HALF)*RADAR_SCALE };
}
function drawRadarBackground(){
  radarBgCtx.clearRect(0,0,RADAR_SIZE,RADAR_SIZE);
  radarBgCtx.fillStyle = 'rgba(20,30,45,0.9)';
  radarBgCtx.beginPath();
  radarBgCtx.arc(RADAR_SIZE/2, RADAR_SIZE/2, RADAR_SIZE/2-2, 0, Math.PI*2);
  radarBgCtx.fill();
  radarBgCtx.fillStyle = 'rgba(120,200,190,0.55)';
  for(const w of wallColliders){
    const p = worldToRadar(w.mesh.position.x, w.mesh.position.z);
    const rw = Math.max(2, (w.hx*2/ARENA_HALF)*RADAR_SCALE);
    const rh = Math.max(2, (w.hz*2/ARENA_HALF)*RADAR_SCALE);
    radarBgCtx.fillRect(p.rx-rw/2, p.ry-rh/2, rw, rh);
  }
}
drawRadarBackground();

function drawRadar(){
  radarCtx.clearRect(0,0,RADAR_SIZE,RADAR_SIZE);
  radarCtx.drawImage(radarBg, 0, 0);
  for(const e of enemies){
    if(!e.alive) continue;
    const p = worldToRadar(e.mesh.position.x, e.mesh.position.z);
    radarCtx.beginPath();
    radarCtx.arc(p.rx, p.ry, e.ranged?3.5:3, 0, Math.PI*2);
    radarCtx.fillStyle = e.ranged ? '#c060ff' : '#ff5050';
    radarCtx.fill();
  }
  const pp = worldToRadar(player.pos.x, player.pos.z);
  const dirX = -Math.sin(player.yaw), dirZ = -Math.cos(player.yaw);
  const perpX = -dirZ, perpZ = dirX;
  const size = 7;
  const tipX = pp.rx + dirX*size, tipY = pp.ry + dirZ*size;
  const leftX = pp.rx - dirX*size*0.5 + perpX*size*0.6, leftY = pp.ry - dirZ*size*0.5 + perpZ*size*0.6;
  const rightX = pp.rx - dirX*size*0.5 - perpX*size*0.6, rightY = pp.ry - dirZ*size*0.5 - perpZ*size*0.6;
  radarCtx.beginPath();
  radarCtx.moveTo(tipX,tipY); radarCtx.lineTo(leftX,leftY); radarCtx.lineTo(rightX,rightY);
  radarCtx.closePath();
  radarCtx.fillStyle = '#ffffff';
  radarCtx.fill();
  
  if(state.isSplitscreen && player2.alive) {
      const pp2 = worldToRadar(player2.pos.x, player2.pos.z);
      radarCtx.beginPath();
      radarCtx.arc(pp2.rx, pp2.ry, 4, 0, Math.PI*2);
      radarCtx.fillStyle = '#ff66b2';
      radarCtx.fill();
  }
}

function resolveWallCollision(pos, margin){
  for(const w of wallColliders){
    const dx = pos.x - w.mesh.position.x;
    const dz = pos.z - w.mesh.position.z;
    const ex = w.hx + margin, ez = w.hz + margin;
    if(Math.abs(dx) < ex && Math.abs(dz) < ez){
      const px = ex - Math.abs(dx);
      const pz = ez - Math.abs(dz);
      if(px < pz) pos.x = w.mesh.position.x + (dx<0?-ex:ex);
      else pos.z = w.mesh.position.z + (dz<0?-ez:ez);
    }
  }
}
function isInsideWall(pos, margin){
  for(const w of wallColliders){
    const dx = Math.abs(pos.x - w.mesh.position.x);
    const dz = Math.abs(pos.z - w.mesh.position.z);
    if(dx < w.hx+margin && dz < w.hz+margin) return true;
  }
  return false;
}

