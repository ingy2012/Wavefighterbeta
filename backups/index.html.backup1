const DEFAULT_KEY_BINDINGS = {
  moveForward:'KeyW', moveBack:'KeyS', moveLeft:'KeyA', moveRight:'KeyD',
  jump:'Space', sprint:'ShiftLeft',
  stylePrev:'KeyQ', styleNext:'KeyE',
  slotPrev:'KeyR', slotNext:'KeyF',
  subPrev:'ArrowLeft', subNext:'ArrowRight',
  shout:'KeyT', pause:'Escape', debug:'KeyP', reload:'KeyG',
};
const DEFAULT_GP_BINDINGS = {
  jump:0, shout:3, pause:9, debug:8, sprint:10, reload:1,
  stylePrev:4, styleNext:5, slotPrev:12, slotNext:13, subPrev:14, subNext:15,
  primary:7, secondary:6,
};
const REMAPPABLE_ACTIONS = [
  {key:'moveForward', label:'Move Forward', gp:false},
  {key:'moveBack', label:'Move Back', gp:false},
  {key:'moveLeft', label:'Move Left', gp:false},
  {key:'moveRight', label:'Move Right', gp:false},
  {key:'jump', label:'Jump', gp:true},
  {key:'sprint', label:'Sprint', gp:true},
  {key:'reload', label:'Reload', gp:true},
  {key:'stylePrev', label:'Prev Style', gp:true},
  {key:'styleNext', label:'Next Style', gp:true},
  {key:'slotPrev', label:'Prev Weapon/Spell', gp:true},
  {key:'slotNext', label:'Next Weapon/Spell', gp:true},
  {key:'subPrev', label:'Prev Arrow/LT Spell', gp:true},
  {key:'subNext', label:'Next Arrow/LT Spell', gp:true},
  {key:'shout', label:'Shout', gp:true},
  {key:'pause', label:'Pause', gp:true},
  {key:'debug', label:'Debug Panel', gp:true},
];
const GP_ONLY_ACTIONS = [
  {key:'primary', label:'Primary Action'},
  {key:'secondary', label:'Secondary Action'},
];
function loadBindings(storageKey, defaults){
  try{ const saved = JSON.parse(localStorage.getItem(storageKey)||'{}'); return Object.assign({}, defaults, saved); }
  catch(e){ return Object.assign({}, defaults); }
}
let keyBindings = loadBindings('tf_keybinds', DEFAULT_KEY_BINDINGS);
let gpBindings = loadBindings('tf_gpbinds', DEFAULT_GP_BINDINGS);
function saveKeyBindings(){ localStorage.setItem('tf_keybinds', JSON.stringify(keyBindings)); }
function saveGpBindings(){ localStorage.setItem('tf_gpbinds', JSON.stringify(gpBindings)); }
function prettyKey(code){
  if(!code) return '—';
  return code.replace('Key','').replace('Digit','').replace('Arrow','Ar ');
}
const GP_BUTTON_NAMES = {0:'A',1:'B',2:'X',3:'Y',4:'LB',5:'RB',6:'LT',7:'RT',8:'Select',9:'Start',10:'L3',11:'R3',12:'D-Up',13:'D-Down',14:'D-Left',15:'D-Right'};
function prettyGpButton(idx){ return GP_BUTTON_NAMES[idx] !== undefined ? GP_BUTTON_NAMES[idx] : ('Btn '+idx); }

let settingsOpen = false, settingsReturnTo = 'start';
let listeningForKey = null, listeningForGamepad = null, listenGpSnapshot = [];

function buildSettingsUI(){
  const kEl = document.getElementById('keyBindList');
  const gEl = document.getElementById('gpBindList');
  kEl.innerHTML = ''; gEl.innerHTML = '';
  for(const a of REMAPPABLE_ACTIONS){
    const row = document.createElement('div');
    row.className = 'bindRow';
    row.innerHTML = `<span>${a.label}</span><button class="bindBtn" data-action="${a.key}">${prettyKey(keyBindings[a.key])}</button>`;
    kEl.appendChild(row);
  }
  const gpActions = REMAPPABLE_ACTIONS.filter(a=>a.gp).concat(GP_ONLY_ACTIONS);
  for(const a of gpActions){
    const row = document.createElement('div');
    row.className = 'bindRow';
    row.innerHTML = `<span>${a.label}</span><button class="bindBtn" data-action="${a.key}">${prettyGpButton(gpBindings[a.key])}</button>`;
    gEl.appendChild(row);
  }
  kEl.querySelectorAll('.bindBtn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      listeningForKey = btn.dataset.action;
      btn.textContent = 'Press key…';
      btn.classList.add('listening');
    });
  });
  gEl.querySelectorAll('.bindBtn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      listeningForGamepad = btn.dataset.action;
      listenGpSnapshot = gp ? gp.buttons.map(b=>b.pressed) : [];
      btn.textContent = 'Press btn…';
      btn.classList.add('listening');
    });
  });
}
function openSettings(from){
  settingsReturnTo = from;
  settingsOpen = true;
  listeningForKey = null; listeningForGamepad = null;
  document.getElementById('pauseOverlay').classList.add('hidden');
  document.getElementById('startOverlay').classList.add('hidden');
  document.getElementById('lobbyOverlay').classList.add('hidden');
  document.getElementById('settingsOverlay').classList.remove('hidden');
  buildSettingsUI();
  buildModeButtons();
  buildTouchModeButtons();
}
function closeSettings(){
  settingsOpen = false;
  listeningForKey = null; listeningForGamepad = null;
  document.getElementById('settingsOverlay').classList.add('hidden');
  if(settingsReturnTo==='pause') document.getElementById('pauseOverlay').classList.remove('hidden');
  else if (settingsReturnTo==='lobby') document.getElementById('lobbyOverlay').classList.remove('hidden');
  else document.getElementById('startOverlay').classList.remove('hidden');
}

const keys = {};
addEventListener('keydown', e=>{
  if(listeningForKey){
    if(e.code !== 'Escape'){ keyBindings[listeningForKey] = e.code; saveKeyBindings(); }
    listeningForKey = null;
    buildSettingsUI();
    e.preventDefault();
    return;
  }
  keys[e.code]=true;
  if(!gameStarted && !settingsOpen && e.code==='Enter'){ enterArena(false, false); return; }
  handleKeyAction(e.code);
});
addEventListener('keyup', e=>{ keys[e.code]=false; });

let pointerLocked = false;
canvas.addEventListener('click', ()=>{
  if(!gameStarted || touchControlsEnabled) return;
  if(document.pointerLockElement !== canvas) canvas.requestPointerLock();
});
document.addEventListener('pointerlockchange', ()=>{ pointerLocked = document.pointerLockElement === canvas; });
addEventListener('mousemove', e=>{
  if(!pointerLocked || paused || !player.alive) return;
  player.yaw -= e.movementX * 0.0022;
  player.pitch -= e.movementY * 0.0022;
  player.pitch = Math.max(-1.3, Math.min(1.3, player.pitch));
});
let mouseDown=false, mouseRDown=false;
addEventListener('mousedown', e=>{ if(e.button===0) mouseDown=true; if(e.button===2) mouseRDown=true; });
addEventListener('mouseup', e=>{ if(e.button===0) mouseDown=false; if(e.button===2) mouseRDown=false; });
addEventListener('contextmenu', e=>e.preventDefault());

function handleKeyAction(code){
  if(settingsOpen) return;
  if(code===keyBindings.debug){ toggleDebug(); return; }
  if(!gameStarted || !player.alive) return;
  if(code===keyBindings.stylePrev) cycleStyle(-1);
  if(code===keyBindings.styleNext) cycleStyle(1);
  if(code===keyBindings.slotPrev) cycleSlot(-1);
  if(code===keyBindings.slotNext) cycleSlot(1);
  if(code===keyBindings.subPrev) cycleSubSlot(-1);
  if(code===keyBindings.subNext) cycleSubSlot(1);
  if(code===keyBindings.shout) tryShout();
  if(code===keyBindings.pause) togglePause();
  if(code===keyBindings.jump) tryJump();
  if(code===keyBindings.reload) tryReload();
}
let debugOn = false;
function toggleDebug(){
  debugOn = !debugOn;
  document.getElementById('debugPanel').style.display = debugOn ? 'block' : 'none';
}

let gp = null;
let gp2 = null; // Second gamepad for splitscreen
let prevButtons = [];
function pollGamepad(){
  const pads = navigator.getGamepads ? navigator.getGamepads() : [];
  gp = null;
  gp2 = null;
  for(const p of pads){ 
      if(p && !gp) gp = p; 
      else if(p && gp) gp2 = p;
  }
}
function gpButtonPressed(i){
  if(!gp) return false;
  const now = gp.buttons[i] && gp.buttons[i].pressed;
  const was = prevButtons[i];
  return now && !was;
}
function gpButtonHeld(i){ return gp && gp.buttons[i] && gp.buttons[i].pressed; }

const enemies = [];

function makeEnemy(ranged){
  const grp = new THREE.Group();
  const baseHex = ranged?0x9b3bdd:0xdd3b3b;
  const mat = new THREE.MeshStandardMaterial({color:baseHex, emissive: ranged?0x220033:0x330000});
  const bodyGeo = new THREE.CylinderGeometry(0.5,0.6,1.4,10);
  const body = new THREE.Mesh(bodyGeo, mat);
  body.position.y = 0.9; body.castShadow=true;
  const headGeo = new THREE.SphereGeometry(0.42,10,10);
  const head = new THREE.Mesh(headGeo, mat);
  head.position.y = 1.85; head.castShadow=true;
  grp.add(body, head);
  grp.userData.mat = mat;
  return grp;
}

function randomEdgePoint(){
  const half = ARENA_HALF - 2;
  const side = Math.floor(Math.random()*4);
  let x,z;
  if(side===0){ x=-half; z=(Math.random()*2-1)*half; }
  else if(side===1){ x=half; z=(Math.random()*2-1)*half; }
  else if(side===2){ z=-half; x=(Math.random()*2-1)*half; }
  else { z=half; x=(Math.random()*2-1)*half; }
  return {x,z};
}
function validEdgePoint(){
  for(let tries=0;tries<10;tries++){
    const p = randomEdgePoint();
    if(!isInsideWall(p, 1.0)) return p;
  }
  return randomEdgePoint();
}

function spawnWaveEnemies(){
  const wave = state.wave;
  const count = Math.min(3 + wave*2, 26);
  const hp = 18 + wave*4;
  const speed = 2.0 + Math.min(wave*0.05, 2.2);
  const rangedChance = Math.min(0.08 + wave*0.045, 0.5);
  state.enemiesRemaining = count;
  for(let i=0;i<count;i++){
    const ranged = Math.random() < rangedChance;
    const p = validEdgePoint();
    const mesh = makeEnemy(ranged);
    mesh.position.set(p.x, 0, p.z);
    scene.add(mesh);
    enemies.push({
      mesh, hp, maxHp:hp, speed: speed*(ranged?0.85:1),
      ranged, attackCd:0, alive:true,
      preferredRange: ranged ? (7+Math.random()*4) : 1.4,
      baseColorHex: ranged?0x9b3bdd:0xdd3b3b,
      frozenTimer:0, stunTimer:0, dotTimer:0, dotDmg:0, dotAcc:0, slowTimer:0, slowFactor:1,
    });
  }
}

function damageEnemy(e, dmg){
  if(!e.alive) return;
  e.hp -= dmg;
  e.mesh.userData.mat.emissive.setHex(0xffffff);
  setTimeout(()=>{ if(e.mesh.userData.mat) e.mesh.userData.mat.emissive.setHex(e.ranged?0x220033:0x330000); }, 90);
  if(e.hp <= 0 && e.alive){
    e.alive = false;
    scene.remove(e.mesh);
    state.enemiesRemaining--;
    const mult = gameMode==='precision' ? state.precisionMultiplier : 1;
    state.score += Math.round(10 * mult);
  }
}

const projectiles = [];
const effects = [];

const shieldGeo = new THREE.SphereGeometry(1.15, 16, 12);
const shieldMat = new THREE.MeshBasicMaterial({color:0x66d9ff, transparent:true, opacity:0.3, side:THREE.DoubleSide});
const shieldMesh = new THREE.Mesh(shieldGeo, shieldMat);
shieldMesh.visible = false;
scene.add(shieldMesh);
function updateShieldVisual(dt){
  if(player.shieldTimer > 0){
    player.shieldTimer -= dt;
    shieldMesh.visible = true;
    shieldMesh.position.copy(player.pos);
    shieldMesh.rotation.y += dt*0.8;
    shieldMesh.material.opacity = 0.22 + 0.15*Math.sin(performance.now()*0.008);
    if(player.shieldTimer <= 0){ player.shieldTimer = 0; shieldMesh.visible = false; showMsg('SHIELD FADED'); }
  } else {
    shieldMesh.visible = false;
  }
}
const geoArrow = new THREE.ConeGeometry(0.06,0.6,6);
const geoBall = new THREE.SphereGeometry(0.22,8,8);
const geoEnemyBolt = new THREE.SphereGeometry(0.18,8,8);
const matEnemyBolt = new THREE.MeshBasicMaterial({color:0xc06aff});

function spawnProjectile(opts){ scene.add(opts.mesh); projectiles.push(opts); }

function fireArrow(damage){
  const type = ARROW_TYPES[player.arrowTypeIndex];
  const dir = getForward();
  const mat = new THREE.MeshBasicMaterial({color:type.color});
  const mesh = new THREE.Mesh(geoArrow, mat);
  mesh.position.copy(player.pos).add(dir.clone().multiplyScalar(0.6));
  mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0), dir);
  spawnProjectile({mesh, vel:dir.clone().multiplyScalar(40), dmg:damage, friendly:true, life:2.5, splash:0,
    onHit:(e)=>{
      if(type.dot){ e.dotTimer=type.dot.time; e.dotDmg=type.dot.dmg; e.dotAcc=0; }
      if(type.slow){ e.slowTimer=type.slow.time; e.slowFactor=type.slow.factor; }
    }});
}
function fireFireballCharged(frac){
  const spell = RT_SPELLS[0];
  const dmg = spell.baseDmg + (spell.maxDmg-spell.baseDmg)*frac;
  const splash = spell.baseSplash + (spell.maxSplash-spell.baseSplash)*frac;
  const dir = getForward();
  const mat = new THREE.MeshBasicMaterial({color:spell.color});
  const mesh = new THREE.Mesh(geoBall, mat);
  mesh.scale.setScalar(0.8+frac*0.9);
  mesh.position.copy(player.pos).add(dir.clone().multiplyScalar(0.6));
  spawnProjectile({mesh, vel:dir.clone().multiplyScalar(22), dmg, friendly:true, life:3, splash});
}
function fireIceSpikeCharged(frac){
  const spell = RT_SPELLS[1];
  const dmg = spell.baseDmg + (spell.maxDmg-spell.baseDmg)*frac;
  const dir = getForward();
  const mat = new THREE.MeshBasicMaterial({color:spell.color});
  const mesh = new THREE.Mesh(geoBall, mat);
  mesh.scale.setScalar(0.7+frac*0.6);
  mesh.position.copy(player.pos).add(dir.clone().multiplyScalar(0.6));
  spawnProjectile({mesh, vel:dir.clone().multiplyScalar(30), dmg, friendly:true, life:3, splash:0,
    onHit:(e)=>{
      if(frac >= spell.freezeThreshold){ e.frozenTimer = spell.freezeTime; showMsg('FROZEN SOLID!'); }
      else { e.slowTimer = 2; e.slowFactor = 0.5; showMsg('CHILLED'); }
    }});
}
function firePoisonBolt(){
  const spell = LT_SPELLS[0];
  const dir = getForward();
  const mat = new THREE.MeshBasicMaterial({color:spell.color});
  const mesh = new THREE.Mesh(geoBall, mat);
  mesh.scale.setScalar(0.6);
  mesh.position.copy(player.pos).add(dir.clone().multiplyScalar(0.6));
  spawnProjectile({mesh, vel:dir.clone().multiplyScalar(28), dmg:spell.dmg, friendly:true, life:3, splash:0,
    onHit:(e)=>{ e.dotTimer=spell.dot.time; e.dotDmg=spell.dot.dmg; e.dotAcc=0; e.slowTimer=spell.slow.time; e.slowFactor=spell.slow.factor; }});
}
function fireEnemyBolt(e){
  const dir = player.pos.clone().sub(e.mesh.position).setY(0).normalize();
  const mesh = new THREE.Mesh(geoEnemyBolt, matEnemyBolt);
  mesh.position.copy(e.mesh.position).add(new THREE.Vector3(0,1.1,0)).add(dir.clone().multiplyScalar(0.6));
  spawnProjectile({mesh, vel:dir.clone().multiplyScalar(14), dmg:9, friendly:false, life:4, splash:0});
}
function fireLightningCharged(frac){
  const spell = RT_SPELLS[2];
  let dmg = spell.baseDmg + (spell.maxDmg-spell.baseDmg)*frac;
  const dir = getForward();
  const origin = player.pos.clone();
  raycaster.set(origin, dir);
  raycaster.far = 60;
  const targets = wallMeshes.concat(enemies.filter(e=>e.alive).map(e=>e.mesh));
  const hits = raycaster.intersectObjects(targets, true);
  if(!hits.length){ showMsg('MISS'); return; }
  const hitMesh = hits[0].object;
  let current = enemies.find(en=>en.alive && (en.mesh===hitMesh.parent || en.mesh===hitMesh));
  if(!current){ return; }
  const points = [origin.clone()];
  const hitSet = new Set();
  for(let chain=0; chain<=spell.maxChain; chain++){
    if(!current || !current.alive) break;
    damageEnemy(current, dmg);
    current.stunTimer = Math.max(current.stunTimer, spell.stunTime);
    hitSet.add(current);
    points.push(current.mesh.position.clone().setY(1));
    dmg *= spell.chainFalloff;
    let next = null, bestD = spell.chainRange;
    for(const e2 of enemies){
      if(!e2.alive || hitSet.has(e2)) continue;
      const d = e2.mesh.position.distanceTo(current.mesh.position);
      if(d < bestD){ bestD = d; next = e2; }
    }
    current = next;
  }
  spawnBeam(points, spell.color);
}
function spawnBeam(points, color){
  const geo = new THREE.BufferGeometry().setFromPoints(points);
  const mat = new THREE.LineBasicMaterial({color, transparent:true, opacity:0.9, linewidth:2});
  const line = new THREE.Line(geo, mat);
  scene.add(line);
  effects.push({mesh:line, life:0.18, maxLife:0.18, isBeam:true});
}
function spawnRing(color){
  const ringGeo2 = new THREE.RingGeometry(0.5,0.7,24);
  const ringMat2 = new THREE.MeshBasicMaterial({color, transparent:true, opacity:0.8, side:THREE.DoubleSide});
  const ringMesh = new THREE.Mesh(ringGeo2, ringMat2);
  ringMesh.rotation.x = -Math.PI/2;
  ringMesh.position.copy(player.pos).setY(0.1);
  scene.add(ringMesh);
  effects.push({mesh:ringMesh, life:0.4, maxLife:0.4});
}
function updateEffects(dt){
  for(let i=effects.length-1;i>=0;i--){
    const fx = effects[i];
    fx.life -= dt;
    const t = 1-(fx.life/fx.maxLife);
    if(fx.isBeam){
      fx.mesh.material.opacity = 0.9*(1-t);
    } else {
      fx.mesh.scale.setScalar(1+t*7);
      fx.mesh.material.opacity = 0.8*(1-t);
    }
    if(fx.life<=0){ scene.remove(fx.mesh); effects.splice(i,1); }
  }
}

function getForward(){
  const dir = new THREE.Vector3(0,0,-1);
  const e = new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ');
  dir.applyEuler(e);
  return dir;
}

let gameStarted = false, paused = false;
let bestWave = parseInt(localStorage.getItem('tf_bestwave')||'0',10);
let bestScore = parseInt(localStorage.getItem('tf_bestscore')||'0',10);
document.getElementById('bestWave').textContent = bestWave;
document.getElementById('bestScore').textContent = bestScore;

const GAME_MODES = {
  unlimited: 'Classic — infinite ammo and mana.',
  ammo: 'Limited ammo, refilled each wave. Reload with the Reload action when empty.',
  precision: 'Unlimited ammo, but firing repeatedly lowers a score precision multiplier.',
};
let gameMode = localStorage.getItem('tf_gamemode') || 'unlimited';
const PRECISION_DECAY_PER_SHOT = 0.05;
const PRECISION_REGEN_PER_SEC = 0.12;
const PRECISION_FLOOR = 0.25;

function refillAllAmmo(){
  for(const w of FPS_WEAPONS){
    player.ammo[w.name] = { mag: w.magSize, reserve: w.reserveSize };
  }
  const bow = MELEE_WEAPONS.find(w=>w.isBow);
  player.arrows = bow.quiverSize;
  player.reloading = false; player.reloadTimer = 0; player.reloadingWeapon = null;
}
function startReload(w){
  if(gameMode!=='ammo') return;
  if(player.reloading && player.reloadingWeapon===w.name) return;
  const a = player.ammo[w.name];
  if(!a || a.reserve<=0 || a.mag>=w.magSize) return;
  player.reloading = true;
  player.reloadTimer = w.reloadTime;
  player.reloadingWeapon = w.name;
  showMsg('RELOADING…');
}
function tryReload(){
  if(gameMode!=='ammo' || player.style!=='fps') return;
  startReload(FPS_WEAPONS[player.fpsSlot]);
}
function updateAmmoState(dt){
  if(gameMode!=='ammo' || !player.reloading) return;
  player.reloadTimer -= dt;
  if(player.reloadTimer <= 0){
    const wdef = FPS_WEAPONS.find(w=>w.name===player.reloadingWeapon);
    const a = wdef ? player.ammo[wdef.name] : null;
    if(wdef && a){
      const need = wdef.magSize - a.mag;
      const take = Math.min(need, a.reserve);
      a.mag += take; a.reserve -= take;
    }
    player.reloading = false;
    player.reloadingWeapon = null;
  }
}
function applyPrecisionDecay(){
  if(gameMode!=='precision') return;
  state.precisionMultiplier = Math.max(PRECISION_FLOOR, state.precisionMultiplier - PRECISION_DECAY_PER_SHOT);
}
function setGameMode(mode){
  gameMode = mode;
  localStorage.setItem('tf_gamemode', mode);
  player.reloading = false; player.reloadTimer = 0; player.reloadingWeapon = null;
  state.precisionMultiplier = 1;
  if(mode==='ammo' && gameStarted) refillAllAmmo();
  buildModeButtons();
  updateTouchActionVisibility();
}
function buildModeButtons(){
  document.querySelectorAll('.modeBtn').forEach(btn=>{
    btn.classList.toggle('active', btn.dataset.mode===gameMode);
  });
  const desc = document.getElementById('modeDesc');
  if(desc) desc.textContent = GAME_MODES[gameMode];
}

let touchControlsEnabled = localStorage.getItem('tf_touchcontrols') === '1';
let lookSensitivity = parseFloat(localStorage.getItem('tf_looksens')||'1');
function setLookSensitivity(v){
  lookSensitivity = v;
  localStorage.setItem('tf_looksens', v);
  const label = document.getElementById('sensValueLabel');
  if(label) label.textContent = v.toFixed(1)+'x';
}
const touchState = { mx:0, my:0, primaryHeld:false, secondaryHeld:false };
let joystickTouchId = null, lookTouchId = null, lastLookPos = null;

function setTouchControls(on){
  touchControlsEnabled = on;
  localStorage.setItem('tf_touchcontrols', on ? '1' : '0');
  document.getElementById('touchControls').classList.toggle('enabled', on);
  buildTouchModeButtons();
}
function buildTouchModeButtons(){
  document.querySelectorAll('.touchModeBtn').forEach(btn=>{
    const wantsOn = btn.dataset.touch==='on';
    btn.classList.toggle('active', wantsOn===touchControlsEnabled);
  });
}
function touchActionAllowed(){ return gameStarted && !paused && player.alive; }

function updateTouchActionVisibility(){
  const isBow = player.style==='melee' && MELEE_WEAPONS[player.meleeSlot] && MELEE_WEAPONS[player.meleeSlot].isBow;
  const isMagic = player.style==='magic';
  const showSub = isBow || isMagic;
  const showReload = player.style==='fps' && gameMode==='ammo';
  const showShout = isMagic;
  const subLabel = isBow ? 'Arw' : 'LTSp';
  const slotLabel = isMagic ? 'Spl' : 'Wpn';
  const subPrevEl = document.getElementById('tSubPrev'), subNextEl = document.getElementById('tSubNext');
  const reloadEl = document.getElementById('tReload'), shoutEl = document.getElementById('tShout');
  const slotPrevEl = document.getElementById('tSlotPrev'), slotNextEl = document.getElementById('tSlotNext');
  if(subPrevEl) subPrevEl.textContent = subLabel + '‹';
  if(subNextEl) subNextEl.textContent = subLabel + '›';
  if(slotPrevEl) slotPrevEl.textContent = slotLabel + '‹';
  if(slotNextEl) slotNextEl.textContent = slotLabel + '›';
  if(subPrevEl) subPrevEl.style.display = showSub ? 'flex' : 'none';
  if(subNextEl) subNextEl.style.display = showSub ? 'flex' : 'none';
  if(reloadEl) reloadEl.style.display = showReload ? 'flex' : 'none';
  if(shoutEl) shoutEl.style.display = showShout ? 'flex' : 'none';
}

function setupTouchControls(){
  const base = document.getElementById('touchJoystickBase');
  const knob = document.getElementById('touchJoystickKnob');
  function updateJoystick(t){
    const rect = base.getBoundingClientRect();
    const cx = rect.left+rect.width/2, cy = rect.top+rect.height/2;
    let dx = t.clientX-cx, dy = t.clientY-cy;
    const maxR = rect.width/2;
    const dist = Math.min(maxR, Math.hypot(dx,dy));
    const ang = Math.atan2(dy,dx);
    dx = Math.cos(ang)*dist; dy = Math.sin(ang)*dist;
    knob.style.transform = `translate(${dx}px, ${dy}px)`;
    touchState.mx = dx/maxR; touchState.my = dy/maxR;
  }
  base.addEventListener('touchstart', e=>{
    if(joystickTouchId===null){
      const t = e.changedTouches[0];
      joystickTouchId = t.identifier;
      updateJoystick(t);
    }
    e.preventDefault();
  }, {passive:false});
  base.addEventListener('touchmove', e=>{
    for(const t of e.changedTouches){ if(t.identifier===joystickTouchId) updateJoystick(t); }
    e.preventDefault();
  }, {passive:false});
  function endJoystick(e){
    for(const t of e.changedTouches){
      if(t.identifier===joystickTouchId){
        joystickTouchId = null;
        touchState.mx = 0; touchState.my = 0;
        knob.style.transform = 'translate(0px,0px)';
      }
    }
  }
  base.addEventListener('touchend', endJoystick);
  base.addEventListener('touchcancel', endJoystick);

  const lookZone = document.getElementById('touchLookZone');
  lookZone.addEventListener('touchstart', e=>{
    if(lookTouchId===null){
      const t = e.changedTouches[0];
      lookTouchId = t.identifier;
      lastLookPos = {x:t.clientX, y:t.clientY};
    }
  });
  lookZone.addEventListener('touchmove', e=>{
    if(!touchActionAllowed()){ e.preventDefault(); return; }
    for(const t of e.changedTouches){
      if(t.identifier===lookTouchId){
        const dx = t.clientX - lastLookPos.x;
        const dy = t.clientY - lastLookPos.y;
        player.yaw -= dx * 0.0045 * lookSensitivity;
        player.pitch -= dy * 0.0045 * lookSensitivity;
        player.pitch = Math.max(-1.3, Math.min(1.3, player.pitch));
        lastLookPos = {x:t.clientX, y:t.clientY};
      }
    }
    e.preventDefault();
  }, {passive:false});
  function endLook(e){
    for(const t of e.changedTouches){ if(t.identifier===lookTouchId) lookTouchId = null; }
  }
  lookZone.addEventListener('touchend', endLook);
  lookZone.addEventListener('touchcancel', endLook);

  function bindHold(id, onStart, onEnd){
    const el = document.getElementById(id);
    if(!el) return;
    el.addEventListener('touchstart', e=>{ e.preventDefault(); if(touchActionAllowed()) onStart(); }, {passive:false});
    if(onEnd){
      const end = e=>{ e.preventDefault(); onEnd(); };
      el.addEventListener('touchend', end);
      el.addEventListener('touchcancel', end);
    }
  }
  bindHold('tFire', ()=>{ touchState.primaryHeld = true; }, ()=>{ touchState.primaryHeld = false; });
  bindHold('tAlt', ()=>{ touchState.secondaryHeld = true; }, ()=>{ touchState.secondaryHeld = false; });
  bindHold('tJump', ()=>tryJump());
  bindHold('tSprint', ()=>{ player.sprintToggle = !player.sprintToggle; });
  bindHold('tReload', ()=>tryReload());
  bindHold('tShout', ()=>tryShout());
  bindHold('tStylePrev', ()=>cycleStyle(-1));
  bindHold('tStyleNext', ()=>cycleStyle(1));
  bindHold('tSlotPrev', ()=>cycleSlot(-1));
  bindHold('tSlotNext', ()=>cycleSlot(1));
  bindHold('tSubPrev', ()=>cycleSubSlot(-1));
  bindHold('tSubNext', ()=>cycleSubSlot(1));
  document.getElementById('tPause').addEventListener('touchstart', e=>{ e.preventDefault(); togglePause(); }, {passive:false});
}
setupTouchControls();
updateTouchActionVisibility();
if(touchControlsEnabled) document.getElementById('touchControls').classList.add('enabled');

function cycleStyle(dir){
  let idx = STYLES.indexOf(player.style);
  idx = (idx + dir + STYLES.length) % STYLES.length;
  player.style = STYLES[idx];
  player.aiming=false; player.blocking=false; player.charging=false; player.chargeT=0; player.fpsZoomIndex=0; player.meleeZoomOn=false;
  camera.fov = baseFOV; camera.updateProjectionMatrix();
  updateHudStyle();
}
function cycleSlot(dir){
  if(player.style==='fps'){
    player.fpsSlot = (player.fpsSlot + dir + FPS_WEAPONS.length) % FPS_WEAPONS.length;
    player.fpsZoomIndex = 0; camera.fov = baseFOV; camera.updateProjectionMatrix();
  } else if(player.style==='melee'){
    player.meleeSlot = (player.meleeSlot + dir + MELEE_WEAPONS.length) % MELEE_WEAPONS.length;
    player.charging=false; player.chargeT=0;
    player.meleeZoomOn=false; camera.fov = baseFOV; camera.updateProjectionMatrix();
  } else if(player.style==='magic'){
    player.rtSpellIndex = (player.rtSpellIndex + dir + RT_SPELLS.length) % RT_SPELLS.length;
    player.charging=false; player.chargeT=0;
  }
  updateHudStyle();
}
function cycleSubSlot(dir){
  if(player.style==='melee' && MELEE_WEAPONS[player.meleeSlot].isBow){
    player.arrowTypeIndex = (player.arrowTypeIndex + dir + ARROW_TYPES.length) % ARROW_TYPES.length;
  } else if(player.style==='magic'){
    player.ltSpellIndex = (player.ltSpellIndex + dir + LT_SPELLS.length) % LT_SPELLS.length;
  }
  updateHudStyle();
}
function cycleZoom(){
  const w = FPS_WEAPONS[player.fpsSlot];
  const zooms = w.zoomLevels || [baseFOV];
  player.fpsZoomIndex = (player.fpsZoomIndex+1) % zooms.length;
  camera.fov = zooms[player.fpsZoomIndex];
  camera.updateProjectionMatrix();
}
function updateHudStyle(){
  const styleNames = {fps:'FPS', melee:'MELEE', magic:'MAGIC'};
  document.getElementById('styleName').textContent = styleNames[player.style];
  let wname = '', sub = '';
  if(player.style==='fps'){
    wname = FPS_WEAPONS[player.fpsSlot].name;
  } else if(player.style==='melee'){
    const w = MELEE_WEAPONS[player.meleeSlot];
    wname = w.name;
    if(w.isBow) sub = 'Arrow: ' + ARROW_TYPES[player.arrowTypeIndex].name;
  } else {
    wname = 'RT: ' + RT_SPELLS[player.rtSpellIndex].name;
    sub = 'LT: ' + LT_SPELLS[player.ltSpellIndex].name;
  }
  document.getElementById('weaponName').textContent = wname;
  document.getElementById('subLine').textContent = sub;
  document.getElementById('resLabel').textContent = player.style==='melee' ? 'STAMINA' : 'MANA';
  const resFill = document.getElementById('resFill');
  resFill.className = player.style==='melee' ? 'bar-fill stam' : 'bar-fill';
  updateTouchActionVisibility();
}

function tryJump(){
  if(player.grounded){ player.vy = 6.5; player.grounded=false; }
}

function tryShout(){
  if(player.style!=='magic'){ showMsg('SWITCH TO MAGIC FOR SHOUT'); return; }
  if(player.cooldowns.shout > 0){ showMsg('SHOUT RECHARGING'); return; }
  player.cooldowns.shout = 15;
  showMsg('UNLEASH!');
  flashScreen('120,200,255', 0.25);
  spawnRing(0x88ccff);
  for(const e of enemies){
    if(!e.alive) continue;
    const d = e.mesh.position.distanceTo(player.pos);
    if(d < 8) damageEnemy(e, 55);
  }
}

function showMsg(text){
  const el = document.getElementById('msgCenter');
  el.textContent = text;
  el.style.opacity = 1;
  clearTimeout(showMsg._t);
  showMsg._t = setTimeout(()=>{ el.style.opacity = 0; }, 1300);
}
function flashScreen(rgb, alpha){
  const f = document.getElementById('flash');
  f.style.background = `rgba(${rgb},${alpha})`;
  clearTimeout(flashScreen._t);
  flashScreen._t = setTimeout(()=>{ f.style.background = 'rgba(255,0,0,0)'; }, 120);
}

const raycaster = new THREE.Raycaster();

function hitscanShoot(dmg, spreadAmt){
  const dir = getForward();
  const d = dir.clone();
  if(spreadAmt){
    d.x += (Math.random()-0.5)*spreadAmt;
    d.y += (Math.random()-0.5)*spreadAmt;
    d.normalize();
  }
  raycaster.set(player.pos.clone(), d);
  raycaster.far = 100;
  const targets = wallMeshes.concat(enemies.filter(e=>e.alive).map(e=>e.mesh));
  const hits = raycaster.intersectObjects(targets, true);
  if(hits.length){
    const hitMesh = hits[0].object;
    const e = enemies.find(en=>en.alive && (en.mesh===hitMesh.parent || en.mesh===hitMesh));
    if(e) damageEnemy(e, dmg);
  }
}
function doPrimary(){
  if(!player.alive || player.cooldowns.primary > 0) return;
  if(player.style === 'fps'){
    const w = FPS_WEAPONS[player.fpsSlot];
    if(gameMode==='ammo'){
      if(player.reloading && player.reloadingWeapon===w.name) return;
      const a = player.ammo[w.name];
      if(a && a.mag<=0){
        if(a.reserve>0) startReload(w); else showMsg('OUT OF AMMO');
        return;
      }
      if(a) a.mag -= 1;
    }
    player.cooldowns.primary = w.rate;
    if(w.pellets){ for(let i=0;i<w.pellets;i++) hitscanShoot(w.dmg, w.spread); }
    else if(w.dual){ hitscanShoot(w.dmg, 0.04); }
    else hitscanShoot(w.dmg, 0);
    flashScreen('255,220,150', 0.08);
    applyPrecisionDecay();
  } else if(player.style === 'melee'){
    const w = MELEE_WEAPONS[player.meleeSlot];
    if(w.isBow){
      if(gameMode==='ammo' && player.arrows<=0){ showMsg('OUT OF ARROWS'); return; }
      player.charging = true;
    } else {
      player.cooldowns.primary = w.cd;
      const dir = getForward();
      for(const e of enemies){
        if(!e.alive) continue;
        const toE = e.mesh.position.clone().sub(player.pos);
        const dist = toE.length();
        if(dist < w.range){
          toE.normalize();
          if(toE.dot(dir) > w.angle) damageEnemy(e, w.dmg);
        }
      }
      flashScreen('255,255,255', 0.06);
    }
  } else if(player.style === 'magic'){
    const spell = RT_SPELLS[player.rtSpellIndex];
    if(player.mana < spell.manaCost){ showMsg('NOT ENOUGH MANA'); return; }
    player.charging = true;
  }
}
function releasePrimary(){
  if(player.style==='melee' && MELEE_WEAPONS[player.meleeSlot].isBow && player.charging){
    const charge = Math.min(player.chargeT, 1.4) / 1.4;
    const dmg = 14 + charge*40;
    fireArrow(dmg);
    if(gameMode==='ammo') player.arrows = Math.max(0, player.arrows - 1);
    applyPrecisionDecay();
    player.charging = false; player.chargeT = 0;
    player.cooldowns.primary = 0.25;
  } else if(player.style==='magic' && player.charging){
    const spell = RT_SPELLS[player.rtSpellIndex];
    const frac = Math.min(player.chargeT, 1.4) / 1.4;
    player.mana -= spell.manaCost;
    if(player.rtSpellIndex===0) fireFireballCharged(frac);
    else if(player.rtSpellIndex===1) fireIceSpikeCharged(frac);
    else fireLightningCharged(frac);
    applyPrecisionDecay();
    player.charging = false; player.chargeT = 0;
    player.cooldowns.primary = 0.5;
  }
}
function castLTSpell(){
  const spell = LT_SPELLS[player.ltSpellIndex];
  if(player.mana < spell.manaCost){ showMsg('NOT ENOUGH MANA'); return; }
  if(player.cooldowns.secondary > 0) return;
  if(player.ltSpellIndex===0){
    player.mana -= spell.manaCost; player.cooldowns.secondary = spell.cd;
    firePoisonBolt();
    applyPrecisionDecay();
  } else if(player.ltSpellIndex===1){
    player.mana -= spell.manaCost; player.cooldowns.secondary = spell.cd;
    spawnRing(0xffffff);
    flashScreen('220,220,255',0.15);
    applyPrecisionDecay();
    for(const e of enemies){
      if(!e.alive) continue;
      const d = e.mesh.position.distanceTo(player.pos);
      if(d < spell.radius){
        damageEnemy(e, spell.dmg);
        e.stunTimer = spell.stun;
        const dir = e.mesh.position.clone().sub(player.pos).setY(0).normalize();
        e.mesh.position.addScaledVector(dir, spell.knockback);
        resolveWallCollision(e.mesh.position, 0.6);
      }
    }
  } else if(player.ltSpellIndex===2){
    player.mana -= spell.manaCost; player.cooldowns.secondary = spell.cd;
    doTeleport();
  } else if(player.ltSpellIndex===3){
    player.mana -= spell.manaCost; player.cooldowns.secondary = spell.cd;
    player.shieldTimer = spell.duration;
    showMsg('AEGIS SHIELD');
    flashScreen('120,220,255',0.25);
  }
}
function doTeleport(){
  const half = ARENA_HALF-2;
  let found = null;
  for(let tries=0;tries<30;tries++){
    const x = (Math.random()*2-1)*half;
    const z = (Math.random()*2-1)*half;
    if(!isInsideWall({x,z}, 1.2)){ found = {x,z}; break; }
  }
  if(found){
    player.pos.x = found.x; player.pos.z = found.z;
    showMsg('TELEPORT');
    flashScreen('255,255,255',0.3);
  } else {
    showMsg('TELEPORT FAILED');
  }
}
function doSecondaryPress(){
  if(player.style === 'fps'){
    const w = FPS_WEAPONS[player.fpsSlot];
    if(w.dual){
      if(player.cooldowns.secondary <= 0){
        if(gameMode==='ammo'){
          if(player.reloading && player.reloadingWeapon===w.name) return;
          const a = player.ammo[w.name];
          if(a && a.mag<=0){
            if(a.reserve>0) startReload(w); else showMsg('OUT OF AMMO');
            return;
          }
          if(a) a.mag -= 1;
        }
        player.cooldowns.secondary = w.rate;
        hitscanShoot(w.dmg, 0.04);
        flashScreen('255,220,150', 0.08);
        applyPrecisionDecay();
      }
    } else {
      cycleZoom();
    }
  } else if(player.style === 'melee'){
    const w = MELEE_WEAPONS[player.meleeSlot];
    if(w.canBlock){ player.blocking = true; }
    else if(w.isBow){
      player.meleeZoomOn = !player.meleeZoomOn;
      camera.fov = player.meleeZoomOn ? 58 : baseFOV;
      camera.updateProjectionMatrix();
    }
  } else if(player.style === 'magic'){
    castLTSpell();
  }
}
function doSecondaryRelease(){
  if(player.style === 'melee') player.blocking = false;
}

const moveVec = new THREE.Vector3();
function updateMovement(dt){
  let mx=0, my=0;
  if(keys[keyBindings.moveForward]) my -= 1;
  if(keys[keyBindings.moveBack]) my += 1;
  if(keys[keyBindings.moveLeft]) mx -= 1;
  if(keys[keyBindings.moveRight]) mx += 1;
  if(gp){
    const lx = gp.axes[0]||0, ly = gp.axes[1]||0;
    if(Math.abs(lx)>0.15) mx += lx;
    if(Math.abs(ly)>0.15) my += ly;
    const rx = gp.axes[2]||0, ry = gp.axes[3]||0;
    if(Math.abs(rx)>0.12) player.yaw -= rx * 2.4 * dt * lookSensitivity;
    if(Math.abs(ry)>0.12) player.pitch -= ry * 2.0 * dt * lookSensitivity;
    player.pitch = Math.max(-1.3, Math.min(1.3, player.pitch));
  }
  if(touchControlsEnabled){
    mx += touchState.mx;
    my += touchState.my;
  }
  const len = Math.hypot(mx,my);
  if(len>1){ mx/=len; my/=len; }
  const zoomedIn = (player.style==='fps' && player.fpsZoomIndex>0) || (player.style==='melee' && player.meleeZoomOn);
  const sprinting = (keys[keyBindings.sprint] || player.sprintToggle) && !player.blocking && !zoomedIn && !player.charging;
  const speed = player.blocking ? 2.2 : (zoomedIn || player.charging ? 2.8 : (sprinting ? 8.5 : 5.2));
  const fwd = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
  const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
  moveVec.set(0,0,0);
  moveVec.addScaledVector(fwd, -my);
  moveVec.addScaledVector(right, mx);
  if(moveVec.lengthSq()>0) moveVec.normalize();
  const next = player.pos.clone().addScaledVector(moveVec, speed*dt);

  resolveWallCollision(next, 0.5);
  const half = ARENA_HALF-1;
  next.x = Math.max(-half, Math.min(half, next.x));
  next.z = Math.max(-half, Math.min(half, next.z));
  player.pos.x = next.x; player.pos.z = next.z;

  player.vy -= 18*dt;
  player.pos.y += player.vy*dt;
  if(player.pos.y <= EYE_H){ player.pos.y = EYE_H; player.vy = 0; player.grounded = true; }

  camera.position.copy(player.pos);
  camera.rotation.order = 'YXZ';
  camera.rotation.y = player.yaw;
  camera.rotation.x = player.pitch;

  p1Mesh.position.copy(player.pos);
  p1Mesh.rotation.y = player.yaw;
}

// Minimal movement update for Player 2
function updateMovementP2(dt) {
    if(!player2.alive) return;
    let mx=0, my=0;
    
    // Numpad / Arrow keys fallback for testing without gamepad 2
    if(keys['ArrowUp']) my -= 1;
    if(keys['ArrowDown']) my += 1;
    if(keys['ArrowLeft']) mx -= 1;
    if(keys['ArrowRight']) mx += 1;

    // Gamepad 2 support
    if(gp2){
      const lx = gp2.axes[0]||0, ly = gp2.axes[1]||0;
      if(Math.abs(lx)>0.15) mx += lx;
      if(Math.abs(ly)>0.15) my += ly;
      const rx = gp2.axes[2]||0, ry = gp2.axes[3]||0;
      if(Math.abs(rx)>0.12) player2.yaw -= rx * 2.4 * dt * lookSensitivity;
      if(Math.abs(ry)>0.12) player2.pitch -= ry * 2.0 * dt * lookSensitivity;
      player2.pitch = Math.max(-1.3, Math.min(1.3, player2.pitch));
    }

    const len = Math.hypot(mx,my);
    if(len>1){ mx/=len; my/=len; }
    
    const speed = 5.2; // Base speed for P2
    const fwd = new THREE.Vector3(-Math.sin(player2.yaw), 0, -Math.cos(player2.yaw));
    const right = new THREE.Vector3(Math.cos(player2.yaw), 0, -Math.sin(player2.yaw));
    const mv = new THREE.Vector3(0,0,0);
    mv.addScaledVector(fwd, -my);
    mv.addScaledVector(right, mx);
    if(mv.lengthSq()>0) mv.normalize();
    const next = player2.pos.clone().addScaledVector(mv, speed*dt);
  
    resolveWallCollision(next, 0.5);
    const half = ARENA_HALF-1;
    next.x = Math.max(-half, Math.min(half, next.x));
    next.z = Math.max(-half, Math.min(half, next.z));
    player2.pos.x = next.x; player2.pos.z = next.z;
  
    camera2.position.copy(player2.pos);
    camera2.rotation.order = 'YXZ';
    camera2.rotation.y = player2.yaw;
    camera2.rotation.x = player2.pitch;

    p2Mesh.position.copy(player2.pos);
    p2Mesh.rotation.y = player2.yaw;
}

function updateEnemies(dt){
  for(const e of enemies){
    if(!e.alive) continue;
    e.frozenTimer = Math.max(0, e.frozenTimer-dt);
    e.stunTimer = Math.max(0, e.stunTimer-dt);
    e.slowTimer = Math.max(0, e.slowTimer-dt);
    if(e.dotTimer>0){
      e.dotTimer -= dt; e.dotAcc += dt;
      if(e.dotAcc>=1){ e.dotAcc-=1; damageEnemy(e, e.dotDmg); }
    }
    if(!e.alive) continue;
    const disabled = e.frozenTimer>0 || e.stunTimer>0;
    if(!disabled){
      const spd = e.speed * (e.slowTimer>0 ? e.slowFactor : 1);
      
      // Target finding: find closest player
      let targetPos = player.pos.clone();
      let isTargetingP2 = false;
      if (state.isSplitscreen && player2.alive) {
          const d1 = e.mesh.position.distanceTo(player.pos);
          const d2 = e.mesh.position.distanceTo(player2.pos);
          if (d2 < d1) {
              targetPos = player2.pos.clone();
              isTargetingP2 = true;
          }
      }
      
      const toPlayer = targetPos.setY(0).sub(e.mesh.position.clone().setY(0));
      const dist = toPlayer.length();
      e.attackCd -= dt;
      if(e.ranged){
        if(dist > e.preferredRange+1){ toPlayer.normalize(); e.mesh.position.addScaledVector(toPlayer, spd*dt); }
        else if(dist < e.preferredRange-1){ toPlayer.normalize(); e.mesh.position.addScaledVector(toPlayer, -spd*dt*0.6); }
        if(dist < 22 && e.attackCd<=0){ fireEnemyBolt(e); e.attackCd = 2.2; }
      } else {
        if(dist > 1.3){ toPlayer.normalize(); e.mesh.position.addScaledVector(toPlayer, spd*dt); }
        else if(e.attackCd<=0){
            if (!isTargetingP2) {
                if(player.shieldTimer > 0){
                    flashScreen('120,220,255',0.15);
                } else {
                    let dmg = 9;
                    if(player.blocking) dmg *= 0.3;
                    player.hp -= dmg;
                    flashScreen('255,40,40',0.22);
                }
            } else {
                player2.hp -= 9; // Basic P2 damage
            }
            e.attackCd = 0.9;
        }
      }
      resolveWallCollision(e.mesh.position, 0.6);
    }
    e.mesh.lookAt(player.pos.x, e.mesh.position.y, player.pos.z);
    if(e.frozenTimer>0) e.mesh.userData.mat.color.setHex(0x2a6fdd);
    else if(e.dotTimer>0) e.mesh.userData.mat.color.setHex(0x66ff66);
    else if(e.slowTimer>0) e.mesh.userData.mat.color.setHex(0xaee8ff);
    else e.mesh.userData.mat.color.setHex(e.baseColorHex);
  }
}

function updateProjectiles(dt){
  for(let i=projectiles.length-1;i>=0;i--){
    const p = projectiles[i];
    p.life -= dt;
    p.mesh.position.addScaledVector(p.vel, dt);
    let remove = p.life<=0;
    if(!remove && isInsideWall(p.mesh.position, 0.2)) remove = true;
    if(!remove && p.friendly){
      for(const e of enemies){
        if(!e.alive) continue;
        if(p.mesh.position.distanceTo(e.mesh.position.clone().setY(1)) < 0.9){
          damageEnemy(e, p.dmg);
          if(p.onHit) p.onHit(e);
          if(p.splash>0){
            for(const e2 of enemies){
              if(!e2.alive || e2===e) continue;
              if(e2.mesh.position.distanceTo(e.mesh.position) < p.splash) damageEnemy(e2, p.dmg*0.5);
            }
          }
          remove = true; break;
        }
      }
    } else if(!remove){
      if(p.mesh.position.distanceTo(player.pos) < 1.0){
        if(player.shieldTimer > 0){
          flashScreen('120,220,255',0.15);
        } else {
          let dmg = p.dmg;
          if(player.blocking) dmg *= 0.3;
          player.hp -= dmg;
          flashScreen('180,60,255',0.2);
        }
        remove = true;
      } else if (state.isSplitscreen && player2.alive && p.mesh.position.distanceTo(player2.pos) < 1.0) {
          player2.hp -= p.dmg;
          remove = true;
      }
    }
    if(remove){ scene.remove(p.mesh); projectiles.splice(i,1); }
  }
}

function updateHud(){
  document.getElementById('hpFill').style.width = Math.max(0,player.hp/player.maxHp*100)+'%';
  const res = player.style==='melee' ? player.stamina/player.maxStamina : player.mana/player.maxMana;
  document.getElementById('resFill').style.width = Math.max(0,res*100)+'%';
  document.getElementById('waveText').textContent = 'WAVE ' + state.wave;
  document.getElementById('enemyCount').textContent = state.betweenWaves ? 'wave clear!' : ('enemies: ' + state.enemiesRemaining);
  document.getElementById('scoreText').textContent = 'Score: ' + state.score;

  const ammoEl = document.getElementById('ammoLine');
  if(gameMode==='ammo'){
    if(player.style==='fps'){
      const w = FPS_WEAPONS[player.fpsSlot];
      const a = player.ammo[w.name];
      if(a){
        ammoEl.style.display = 'block';
        ammoEl.textContent = (player.reloading && player.reloadingWeapon===w.name) ? 'RELOADING…' : (a.mag + ' / ' + a.reserve);
      }
    } else if(player.style==='melee' && MELEE_WEAPONS[player.meleeSlot].isBow){
      ammoEl.style.display = 'block';
      ammoEl.textContent = 'Arrows: ' + player.arrows;
    } else {
      ammoEl.style.display = 'none';
    }
  } else if(gameMode==='precision'){
    ammoEl.style.display = 'block';
    ammoEl.textContent = 'Precision: ' + Math.round(state.precisionMultiplier*100) + '%';
  } else {
    ammoEl.style.display = 'none';
  }
  const ring = document.getElementById('chargeRing');
  if(player.charging){
    ring.style.display='block';
    const pct = Math.min(player.chargeT/1.4,1);
    ring.style.clipPath = `inset(${(1-pct)*44}px 0 0 0)`;
  } else ring.style.display='none';

  const tag = document.getElementById('stateTag');
  const zoomLvl = player.style==='fps' ? player.fpsZoomIndex : 0;
  const bowZoom = player.style==='melee' && player.meleeZoomOn;
  const isBlock = player.blocking && player.style==='melee';
  const sprinting = (keys[keyBindings.sprint] || player.sprintToggle) && !player.blocking && !player.charging;
  if(player.shieldTimer>0){ tag.style.display='inline-block'; tag.className='block'; tag.textContent='SHIELDED'; }
  else if(zoomLvl>0){ tag.style.display='inline-block'; tag.className='zoom'; tag.textContent='ZOOM LV.'+zoomLvl; }
  else if(bowZoom){ tag.style.display='inline-block'; tag.className='zoom'; tag.textContent='ZOOMED'; }
  else if(isBlock){ tag.style.display='inline-block'; tag.className='block'; tag.textContent='BLOCKING'; }
  else if(sprinting){ tag.style.display='inline-block'; tag.className='zoom'; tag.textContent='SPRINTING'; }
  else { tag.style.display='none'; }

  if(debugOn) updateDebugPanel();
}
function updateDebugPanel(){
  const el = document.getElementById('debugPanel');
  if(!gp){ el.textContent = 'No gamepad detected.'; return; }
  const pressed = [];
  for(let i=0;i<gp.buttons.length;i++){ if(gp.buttons[i].pressed) pressed.push(i); }
  const axes = gp.axes.map(a=>a.toFixed(2)).join(', ');
  el.innerHTML = `<b>Gamepad 1 debug (P)</b><br>id: ${gp.id.slice(0,40)}<br>buttons: [${pressed.join(', ')}]<br>axes: [${axes}]`;
  if(gp2) {
      const p2 = [];
      for(let i=0;i<gp2.buttons.length;i++){ if(gp2.buttons[i].pressed) p2.push(i); }
      el.innerHTML += `<br><br><b>Gamepad 2 active</b><br>buttons: [${p2.join(', ')}]`;
  }
}

function updateResources(dt){
  if(player.style==='melee'){
    if(player.blocking) player.stamina -= 12*dt;
    else player.stamina += 10*dt;
    player.stamina = Math.max(0, Math.min(player.maxStamina, player.stamina));
    if(player.stamina<=0) player.blocking=false;
  } else {
    player.mana += 5*dt;
    player.mana = Math.max(0, Math.min(player.maxMana, player.mana));
  }
  for(const k in player.cooldowns) player.cooldowns[k] = Math.max(0, player.cooldowns[k]-dt);
  if(player.charging) player.chargeT += dt;
  if(gameMode==='precision'){
    state.precisionMultiplier = Math.min(1, state.precisionMultiplier + PRECISION_REGEN_PER_SEC*dt);
  }
  updateAmmoState(dt);
}

function startWave(){
  state.wave++;
  state.betweenWaves = false;
  showMsg('WAVE ' + state.wave);
  player.hp = Math.min(player.maxHp, player.hp + 15);
  if(gameMode==='ammo') refillAllAmmo();
  if(state.wave > 1){
    generateInteriorMaze();
    resolveWallCollision(player.pos, 0.6);
    const half = ARENA_HALF-1;
    player.pos.x = Math.max(-half, Math.min(half, player.pos.x));
    player.pos.z = Math.max(-half, Math.min(half, player.pos.z));
    if(state.isSplitscreen) {
        resolveWallCollision(player2.pos, 0.6);
        player2.pos.x = Math.max(-half, Math.min(half, player2.pos.x));
        player2.pos.z = Math.max(-half, Math.min(half, player2.pos.z));
    }
    drawRadarBackground();
  }
  spawnWaveEnemies();
}
function checkWaveClear(){
  if(!state.betweenWaves && state.enemiesRemaining<=0){
    if(enemies.filter(e=>e.alive).length===0){
      state.betweenWaves = true;
      showMsg('WAVE CLEAR');
      setTimeout(()=>{ if(player.alive) startWave(); }, 2200);
    }
  }
}

function die(){
  player.alive = false;
  if(document.exitPointerLock) document.exitPointerLock();
  if(state.wave > bestWave){ bestWave = state.wave; localStorage.setItem('tf_bestwave', bestWave); }
  if(state.score > bestScore){ bestScore = state.score; localStorage.setItem('tf_bestscore', bestScore); }
  document.getElementById('deathWaveText').textContent = 'You reached wave ' + state.wave + ' — Score: ' + state.score;
  document.getElementById('deathOverlay').classList.remove('hidden');
}

function togglePause(){
  if(!gameStarted || !player.alive) return;
  paused = !paused;
  document.getElementById('pauseOverlay').classList.toggle('hidden', !paused);
  if(paused && document.pointerLockElement) document.exitPointerLock();
}

let lastT = performance.now();
let primaryHeldPrev = false, secondaryHeldPrev = false;

function frame(now){
  requestAnimationFrame(frame);
  const dt = Math.min(0.05, (now-lastT)/1000);
  lastT = now;
  pollGamepad();

  if(settingsOpen){
    if(listeningForGamepad && gp){
      for(let i=0;i<gp.buttons.length;i++){
        if(gp.buttons[i].pressed && !listenGpSnapshot[i]){
          gpBindings[listeningForGamepad] = i;
          saveGpBindings();
          listeningForGamepad = null;
          buildSettingsUI();
          break;
        }
      }
    }
    prevButtons = gp ? gp.buttons.map(b=>b.pressed) : [];
    renderer.render(scene, camera); // Basic render when paused
    return;
  }

  if(gpButtonPressed(gpBindings.debug)) toggleDebug();

  if(!gameStarted && gpButtonPressed(0)){
    enterArena(false, false);
  }

  if(gameStarted && !paused && player.alive){
    if(gpButtonPressed(gpBindings.stylePrev)) cycleStyle(-1);
    if(gpButtonPressed(gpBindings.styleNext)) cycleStyle(1);
    if(gpButtonPressed(gpBindings.slotPrev)) cycleSlot(-1);
    if(gpButtonPressed(gpBindings.slotNext)) cycleSlot(1);
    if(gpButtonPressed(gpBindings.subPrev)) cycleSubSlot(-1);
    if(gpButtonPressed(gpBindings.subNext)) cycleSubSlot(1);
    if(gpButtonPressed(gpBindings.shout)) tryShout();
    if(gpButtonPressed(gpBindings.jump)) tryJump();
    if(gpButtonPressed(gpBindings.reload)) tryReload();
    if(gpButtonPressed(gpBindings.pause)) togglePause();
    if(gpButtonPressed(gpBindings.sprint)) player.sprintToggle = !player.sprintToggle;

    const primaryHeld = mouseDown || gpButtonHeld(gpBindings.primary) || (touchControlsEnabled && touchState.primaryHeld);
    const secondaryHeld = mouseRDown || gpButtonHeld(gpBindings.secondary) || (touchControlsEnabled && touchState.secondaryHeld);
    if(primaryHeld && !primaryHeldPrev) doPrimary();
    if(!primaryHeld && primaryHeldPrev) releasePrimary();
    if(player.style==='fps' && primaryHeld && FPS_WEAPONS[player.fpsSlot].name==='Assault Rifle' && player.cooldowns.primary<=0){
      doPrimary();
    }
    if(secondaryHeld && !secondaryHeldPrev) doSecondaryPress();
    if(!secondaryHeld && secondaryHeldPrev) doSecondaryRelease();
    if(player.style==='fps' && FPS_WEAPONS[player.fpsSlot].dual){
      if(primaryHeld && player.cooldowns.primary<=0) doPrimary();
      if(secondaryHeld && player.cooldowns.secondary<=0) doSecondaryPress();
    }
    primaryHeldPrev = primaryHeld; secondaryHeldPrev = secondaryHeld;

    updateMovement(dt);
    if (state.isSplitscreen) {
        updateMovementP2(dt);
        if (player2.hp <= 0) player2.alive = false;
    }

    updateEnemies(dt);
    updateProjectiles(dt);
    updateEffects(dt);
    updateShieldVisual(dt);
    updateResources(dt);
    checkWaveClear();

    if(player.hp <= 0){ player.hp = 0; die(); }

    prevButtons = gp ? gp.buttons.map(b=>b.pressed) : [];
  } else if(gp){
    prevButtons = gp.buttons.map(b=>b.pressed);
  }

  updateHud();
  if(gameStarted) drawRadar();
  
  // ==========================================
  // SPLITSCREEN RENDERING LOGIC
  // ==========================================
  if (state.isSplitscreen) {
      renderer.setScissorTest(true);
      
      // LEFT SCREEN (Player 1)
      renderer.setScissor(0, 0, innerWidth / 2, innerHeight);
      renderer.setViewport(0, 0, innerWidth / 2, innerHeight);
      renderer.render(scene, camera);
      
      // RIGHT SCREEN (Player 2)
      renderer.setScissor(innerWidth / 2, 0, innerWidth / 2, innerHeight);
      renderer.setViewport(innerWidth / 2, 0, innerWidth / 2, innerHeight);
      renderer.render(scene, camera2);
      
      renderer.setScissorTest(false);
  } else {
      // Standard Single Player Rendering
      renderer.setViewport(0, 0, innerWidth, innerHeight);
      renderer.render(scene, camera);
  }
}
requestAnimationFrame(frame);

window.enterArena = function(useTouch, isSplitscreen){
  if(gameStarted) return;
  state.isSplitscreen = isSplitscreen;
  resize(); // Trigger aspect ratio updates
  setTouchControls(useTouch);
  document.getElementById('startOverlay').classList.add('hidden');
  document.getElementById('lobbyOverlay').classList.add('hidden');
  gameStarted = true;
  updateHudStyle();
  startWave();
  if(!useTouch && canvas.requestPointerLock) canvas.requestPointerLock();
}

document.getElementById('startBtn').addEventListener('touchend', e=>{
  e.preventDefault(); window.enterArena(true, false);
}, {passive:false});
document.getElementById('startBtn').addEventListener('click', ()=>{ window.enterArena(false, false); });

document.getElementById('localSplitBtn').addEventListener('click', ()=>{ window.enterArena(false, true); });

document.getElementById('onlineLobbyBtn').addEventListener('click', ()=>{
    document.getElementById('startOverlay').classList.add('hidden');
    document.getElementById('lobbyOverlay').classList.remove('hidden');
});

document.getElementById('btnLobbyBack').addEventListener('click', ()=>{
    document.getElementById('lobbyOverlay').classList.add('hidden');
    document.getElementById('startOverlay').classList.remove('hidden');
});
document.getElementById('btnLeaveLobby').addEventListener('click', ()=>{
    document.getElementById('activeLobbyPanel').classList.add('hidden');
    document.getElementById('nameEntryPanel').classList.remove('hidden');
    document.getElementById('lobbyOverlay').classList.add('hidden');
    document.getElementById('startOverlay').classList.remove('hidden');
    if (window.leaveFirebaseLobby) window.leaveFirebaseLobby();
});

document.getElementById('retryBtn').addEventListener('click', ()=>{ location.reload(); });
document.getElementById('resumeBtn').addEventListener('click', ()=>{ togglePause(); });
document.getElementById('startSettingsBtn').addEventListener('click', ()=>openSettings('start'));
document.getElementById('pauseSettingsBtn').addEventListener('click', ()=>openSettings('pause'));
document.getElementById('settingsBackBtn').addEventListener('click', closeSettings);
document.getElementById('resetBindsBtn').addEventListener('click', ()=>{
  keyBindings = Object.assign({}, DEFAULT_KEY_BINDINGS);
  gpBindings = Object.assign({}, DEFAULT_GP_BINDINGS);
  saveKeyBindings(); saveGpBindings();
  buildSettingsUI();
});
document.querySelectorAll('.modeBtn').forEach(btn=>{
  btn.addEventListener('click', ()=>setGameMode(btn.dataset.mode));
});
buildModeButtons();
document.querySelectorAll('.touchModeBtn').forEach(btn=>{
  btn.addEventListener('click', ()=>setTouchControls(btn.dataset.touch==='on'));
});
buildTouchModeButtons();
const sensSlider = document.getElementById('sensSlider');
sensSlider.value = lookSensitivity;
document.getElementById('sensValueLabel').textContent = lookSensitivity.toFixed(1)+'x';
sensSlider.addEventListener('input', ()=>{ setLookSensitivity(parseFloat(sensSlider.value)); });

};
</script>

<!-- Firebase Multiplayer Logic -->
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import { getAuth, signInWithCustomToken, signInAnonymously, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { getFirestore, collection, doc, setDoc, onSnapshot, updateDoc, deleteDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    const appId = typeof __app_id !== 'undefined' ? __app_id : 'wavefighters-multi';
    const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : { apiKey: "mock", projectId: "mock" };
    
    let app, auth, db, currentUser = null, myPlayerName = "", heartbeatInterval = null;
    let onlinePlayers = [], incomingRequests = [], currentlyShowingToastFor = null;

    try {
        app = initializeApp(firebaseConfig);
        auth = getAuth(app);
        db = getFirestore(app);
        
        const initAuth = async () => {
            if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                await signInWithCustomToken(auth, __initial_auth_token);
            } else {
                await signInAnonymously(auth);
            }
        };
        initAuth();

        onAuthStateChanged(auth, (user) => { currentUser = user; });
    } catch(e) { console.error("Firebase init failed (Local test mode): ", e); }

    const getPlayersCol = () => collection(db, 'artifacts', appId, 'public', 'data', 'players');
    const getRequestsCol = () => collection(db, 'artifacts', appId, 'public', 'data', 'requests');

    window.joinFirebaseLobby = async function(name) {
        if (!currentUser || !db) return alert("Multiplayer server offline.");
        myPlayerName = name;
        
        document.getElementById('nameEntryPanel').classList.add('hidden');
        document.getElementById('activeLobbyPanel').classList.remove('hidden');

        const myDocRef = doc(getPlayersCol(), currentUser.uid);
        await setDoc(myDocRef, { name: myPlayerName, uid: currentUser.uid, status: 'in-lobby', lastActive: Date.now() });

        heartbeatInterval = setInterval(() => {
            setDoc(myDocRef, { lastActive: Date.now() }, { merge: true });
        }, 5000);

        onSnapshot(getPlayersCol(), (snapshot) => {
            const now = Date.now();
            onlinePlayers = [];
            snapshot.forEach(doc => {
                const data = doc.data();
                if (now - data.lastActive < 15000 && data.uid !== currentUser.uid) {
                    onlinePlayers.push(data);
                }
            });
            renderPlayerList();
        }, (err) => console.error(err));

        onSnapshot(getRequestsCol(), (snapshot) => {
            incomingRequests = [];
            snapshot.forEach(doc => {
                const req = doc.data(); req.id = doc.id;
                if (req.toUid === currentUser.uid && req.status === 'pending') incomingRequests.push(req);
                if (req.fromUid === currentUser.uid && req.status === 'accepted') {
                    alert(`${req.toName} accepted! Starting splitscreen mock.`);
                    deleteDoc(doc.ref);
                    window.enterArena(false, true); // Mock transition
                }
            });
            handleIncomingRequests();
        }, (err) => console.error(err));
    };

    window.leaveFirebaseLobby = function() {
        if (heartbeatInterval) clearInterval(heartbeatInterval);
        if (currentUser && db) deleteDoc(doc(getPlayersCol(), currentUser.uid));
    };

    window.sendJoinRequest = async function(targetUid, targetName) {
        if (!currentUser) return;
        const reqRef = doc(getRequestsCol(), `${currentUser.uid}_${targetUid}`);
        await setDoc(reqRef, { fromUid: currentUser.uid, fromName: myPlayerName, toUid: targetUid, toName: targetName, status: 'pending', timestamp: Date.now() });
        alert(`Request sent to ${targetName}.`);
    };

    window.acceptRequest = async function(requestId, fromName) {
        if (!currentUser) return;
        await updateDoc(doc(getRequestsCol(), requestId), { status: 'accepted' });
        document.getElementById('pauseOverlay').classList.add('hidden');
        window.enterArena(false, true); // Mock starting splitscreen
    };
    
    window.rejectRequest = async function(requestId) {
        if (!currentUser) return;
        await deleteDoc(doc(getRequestsCol(), requestId));
    };

    function renderPlayerList() {
        const listEl = document.getElementById('playerList');
        if (onlinePlayers.length === 0) { listEl.innerHTML = `<div style="color:#888; text-align:center;">No other pilots online.</div>`; return; }
        listEl.innerHTML = onlinePlayers.map(p => `
            <div class="player-list-item">
                <div><span style="font-weight:bold; color:white;">${p.name}</span> <span style="font-size:10px; color:#3bff8a;">● ${p.status}</span></div>
                <button onclick="window.sendJoinRequest('${p.uid}', '${p.name}')" class="bindBtn" style="background: rgba(59,138,255,0.5)">Join</button>
            </div>
        `).join('');
    }

    function handleIncomingRequests() {
        const toastEl = document.getElementById('notification-toast');
        const containerEl = document.getElementById('pending-requests-container');
        if (incomingRequests.length > 0) {
            const req = incomingRequests[0];
            if (currentlyShowingToastFor !== req.id) {
                document.getElementById('toast-desc').innerText = `${req.fromName} wants to join! Press ESC/Pause to manage.`;
                toastEl.classList.add('show');
                currentlyShowingToastFor = req.id;
                setTimeout(() => { toastEl.classList.remove('show'); currentlyShowingToastFor = null; }, 8000);
            }
            containerEl.classList.remove('hidden');
            document.getElementById('requests-list').innerHTML = incomingRequests.map(r => `
                <div style="background:rgba(255,255,255,0.1); padding:8px; border-radius:4px; display:flex; justify-content:space-between; align-items:center;">
                    <span>${r.fromName}</span>
                    <div>
                        <button onclick="window.acceptRequest('${r.id}', '${r.fromName}')" class="bindBtn" style="background:#3bff8a; color:black;">Accept</button>
                        <button onclick="window.rejectRequest('${r.id}')" class="bindBtn" style="background:#ff3b3b;">Reject</button>
                    </div>
                </div>
            `).join('');
        } else {
            toastEl.classList.remove('show');
            currentlyShowingToastFor = null;
            containerEl.classList.add('hidden');
        }
    }

    document.getElementById('btnLogin').addEventListener('click', () => {
        const name = document.getElementById('playerNameInput').value.trim();
        if (name) window.joinFirebaseLobby(name); else alert("Enter a pilot name!");
    });
</script>

<script>
(function(){
  var sources = [
    "https://cdnjs.cloudflare.com/ajax/libs/three.js/r150/three.min.js",
    "https://cdn.jsdelivr.net/npm/three@0.150.0/build/three.min.js"
  ];
  var i = 0;
  function showError(msg){
    document.getElementById('loadingMsg').classList.add('hidden');
    var el = document.getElementById('loadError');
    el.classList.remove('hidden');
    if(msg) document.getElementById('loadErrorDetail').textContent = msg;
  }
  function tryLoad(){
    if(i >= sources.length){
      showError('Could not reach graphics CDN. Check internet connection.');
      return;
    }
    var s = document.createElement('script');
    s.src = sources[i];
    s.onload = function(){
      if(typeof THREE === 'undefined'){ i++; tryLoad(); return; }
      document.getElementById('loadingMsg').classList.add('hidden');
      try{
        if(typeof window.__startGame === 'function'){
          window.__startGame();
        } else {
          showError('Game script initialized incorrectly.');
        }
      }
      catch(err){ showError('Game crashed on startup: ' + (err && err.message ? err.message : err)); }
    };
    s.onerror = function(){ i++; tryLoad(); };
    document.head.appendChild(s);
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tryLoad);
  } else {
    tryLoad();
  }
})();
</script>
</body>
</html>